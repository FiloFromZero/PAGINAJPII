---
import '@fontsource-variable/inter';
import '@fontsource-variable/plus-jakarta-sans';
import '../assets/styles/menu-mobile.css';

---

<style is:inline>
  :root {
    --aw-font-sans: 'InterVariable', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
    --aw-font-serif: 'Lora', Georgia, Cambria, 'Times New Roman', serif;
    --aw-font-heading: 'Plus Jakarta Sans Variable', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;

    /* Professional school color palette - Emerald Theme */
    --aw-color-primary: rgb(10 92 54); /* #0A5C36 Emerald green */
    --aw-color-secondary: rgb(7 70 40); /* #074628 Forest green */
    --aw-color-accent: rgb(217 119 6); /* #D97706 Warm Amber/Gold */
    --aw-color-success: rgb(16 185 129); /* #10B981 */
    --aw-color-warning: rgb(245 158 11); /* #F59E0B */
    --aw-color-error: rgb(239 68 68); /* #EF4444 */

    --aw-color-text-heading: rgb(15 23 42); /* #0F172A Slate 900 */
    --aw-color-text-default: rgb(51 65 85); /* #334155 Slate 700 */
    --aw-color-text-muted: rgb(100 116 139); /* #64748B Slate 500 */
    --aw-color-bg-page: rgb(250 251 249); /* #FAFBF9 Warm off-white */
    --aw-color-bg-secondary: rgb(241 245 249); /* #F1F5F9 Slate 100 */
    --aw-color-border: rgb(226 232 240); /* #E2E8F0 Slate 200 */

    --aw-color-bg-page-dark: rgb(11 19 27); /* #0B131B Slate night */

    ::selection {
      background-color: rgba(10, 92, 54, 0.2);
      color: rgb(7 70 40);
    }
  }

  .dark {
    /* Dark mode with professional emerald colors */
    --aw-color-primary: rgb(16 185 129); /* #10B981 Emerald */
    --aw-color-secondary: rgb(5 150 105); /* #059669 Darker emerald */
    --aw-color-accent: rgb(251 191 36); /* #FBBF24 Yellow/Gold */
    --aw-color-success: rgb(52 211 153);
    --aw-color-warning: rgb(251 191 36);
    --aw-color-error: rgb(248 113 113);

    --aw-color-text-heading: rgb(248 250 252); /* #F8FAFC Slate 50 */
    --aw-color-text-default: rgb(203 213 225); /* #CBD5E1 Slate 300 */
    --aw-color-text-muted: rgb(148 163 184); /* #94A3B8 Slate 400 */
    --aw-color-bg-page: rgb(11 19 27); /* #0B131B Deep slate blue */
    --aw-color-bg-secondary: rgb(19 32 46); /* #13202E Slightly lighter slate */
    --aw-color-border: rgb(30 49 70); /* #1E3146 Slate border */

    ::selection {
      background-color: rgba(16, 185, 129, 0.3);
      color: rgb(248 250 252);
    }
  }
</style>

