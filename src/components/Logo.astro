---
import logoImg from '~/assets/images/logo.png';
import { getImage } from 'astro:assets';

const optimizedLogo = await getImage({
  src: logoImg,
  width: 280,
  height: 132,
  format: 'webp',
});
---

<div class="flex items-center">
  <img
    src={optimizedLogo.src}
    alt="Instituto Psicopedagógico Juan Pablo II"
    width="280"
    height="132"
    class="h-11 sm:h-14 md:h-16 w-auto max-w-[220px] sm:max-w-[280px] object-contain transition-opacity duration-200 hover:opacity-90"
    loading="eager"
    decoding="async"
    fetchpriority="high"
  />
</div>
