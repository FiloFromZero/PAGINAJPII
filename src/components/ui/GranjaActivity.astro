---
import { Icon } from 'astro-icon/components';
import Image from '~/components/common/Image.astro';

export interface Props {
  title: string;
  description: string;
  icon: string;
  imageSrc: string;
  imageAlt: string;
  index?: number;
}

const { title, description, icon, imageSrc, imageAlt, index = 0 } = Astro.props;
---

<div class="flex flex-col bg-white dark:bg-gray-800 rounded-lg shadow-lg overflow-hidden transition-transform duration-300 hover:scale-105" data-animate="animate-fade-in-up" data-animate-delay={index * 100}>
  <div class="relative h-64">
    <Image
      src={imageSrc}
      alt={imageAlt}
      class="w-full h-full object-cover granja-image"
      width={800}
      height={600}
      loading="lazy"
      decoding="async"
      sizes="(max-width: 768px) 100vw, (max-width: 1200px) 50vw, 33vw"
      widths={[400, 800, 1200]}
    />
    <div class="absolute top-4 left-4 bg-primary text-white rounded-full p-2 shadow-md">
      <Icon name={icon} class="w-6 h-6" />
    </div>
  </div>
  <div class="p-6">
    <h3 class="text-xl font-bold text-gray-900 dark:text-white mb-2">{title}</h3>
    <p class="text-gray-700 dark:text-gray-300" set:html={description} />
  </div>
</div>