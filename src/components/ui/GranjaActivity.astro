---
import { Icon } from 'astro-icon/components';
import Image from '~/components/common/Image.astro';

export interface Props {
  title: string;
  description: string;
  icon: string;
  imageSrc: string;
  imageAlt: string;
  index?: number;
}

const { title, description, icon, imageSrc, imageAlt, index = 0 } = Astro.props;
---

<div class="group flex flex-col bg-white dark:bg-slate-800 rounded-2xl shadow-soft hover:shadow-xl border border-slate-100 dark:border-slate-800 overflow-hidden transition-all duration-300" data-animate="animate-fade-in-up" data-tilt data-animate-delay={index * 100}>
  <div class="relative h-64 overflow-hidden">
    <Image
      src={imageSrc}
      alt={imageAlt}
      class="w-full h-full object-cover transition-transform duration-500 ease-out group-hover:scale-105"
      width={800}
      height={600}
      loading="lazy"
      decoding="async"
      sizes="(max-width: 768px) 100vw, (max-width: 1200px) 50vw, 33vw"
      widths={[400, 800, 1200]}
    />
    <div class="absolute top-4 left-4 bg-primary/95 backdrop-blur-sm text-white rounded-xl p-2.5 shadow-md border border-white/20">
      <Icon name={icon} class="w-5 h-5" />
    </div>
  </div>
  <div class="p-6 flex-grow flex flex-col justify-between">
    <div>
      <h3 class="text-xl font-bold font-heading text-gray-900 dark:text-white mb-2 group-hover:text-primary dark:group-hover:text-emerald-400 transition-colors duration-200">{title}</h3>
      <p class="text-gray-600 dark:text-gray-300 text-sm leading-relaxed" set:html={description} />
    </div>
  </div>
</div>