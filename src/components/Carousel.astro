---
import Image from '~/components/common/Image.astro';

export interface Props {
  images: { src: string; alt: string }[];
  autoPlay?: boolean;
  autoPlayInterval?: number;
  showIndicators?: boolean;
  showArrows?: boolean;
  showProgress?: boolean;
}

const {
  images,
  showIndicators = true,
  showArrows = true,
  showProgress = true
} = Astro.props;
---

<div id="carousel" class="relative left-1/2 right-1/2 -mx-[50vw] w-screen overflow-hidden mt-4 mb-8 group">
  <!-- Progress Bar -->
  {showProgress && (
    <div class="absolute top-0 left-0 right-0 z-20">
      <div id="progress-bar" class="h-1 bg-gradient-to-r from-primary to-secondary transition-all duration-300 ease-out"></div>
    </div>
  )}

  <!-- Main Carousel Container -->
  <div class="relative overflow-hidden rounded-2xl shadow-2xl">
    <div id="carousel-inner" class="flex transition-all duration-1000 ease-out h-[280px] md:h-[360px] lg:h-[440px] xl:h-[520px]">
      {images.map(({ src, alt }, index) => (
        <div class="relative flex-shrink-0 w-full h-full group/slide">
          <Image
            src={src}
            alt={alt}
            width={1920}
            height={520}
            sizes="100vw"
            widths={[640, 768, 1024, 1280, 1536, 1920]}
            aspectRatio="3.7:1"
            class="absolute inset-0 w-full h-full object-cover transition-all duration-1000 ease-out group-hover/slide:scale-105"
            data-carousel-index={index}
          />

          <!-- Overlay Gradient -->
          <div class="absolute inset-0 bg-gradient-to-t from-black/60 via-transparent to-black/20"></div>

          <!-- Slide Content Overlay (Optional) -->
          <div class="absolute inset-0 flex items-center justify-center opacity-0 group-hover/slide:opacity-100 transition-opacity duration-500">
            <div class="text-center text-white transform translate-y-4 group-hover/slide:translate-y-0 transition-transform duration-500">
              <h3 class="text-2xl md:text-3xl font-bold mb-2 text-shadow-lg">{alt}</h3>
              <div class="w-16 h-1 bg-accent mx-auto rounded-full"></div>
            </div>
          </div>
        </div>
      ))}
    </div>

    <!-- Side Gradients for Depth -->
    <div class="pointer-events-none absolute inset-y-0 left-0 w-16 sm:w-32 bg-gradient-to-r from-black/40 to-transparent z-10"></div>
    <div class="pointer-events-none absolute inset-y-0 right-0 w-16 sm:w-32 bg-gradient-to-l from-black/40 to-transparent z-10"></div>
  </div>

  <!-- Navigation Arrows -->
  {showArrows && (
    <>
      <button
        id="prevBtn"
        class="absolute left-6 top-1/2 -translate-y-1/2 z-30 bg-white/10 backdrop-blur-md text-white p-4 rounded-full shadow-xl opacity-0 group-hover:opacity-100 transition-all duration-500 hover:bg-white/20 hover:scale-110 focus:outline-none focus:ring-2 focus:ring-white focus:ring-opacity-75 group/btn"
        aria-label="Imagen anterior"
      >
        <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 transition-transform duration-300 group-hover/btn:-translate-x-1" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
        </svg>
      </button>
      <button
        id="nextBtn"
        class="absolute right-6 top-1/2 -translate-y-1/2 z-30 bg-white/10 backdrop-blur-md text-white p-4 rounded-full shadow-xl opacity-0 group-hover:opacity-100 transition-all duration-500 hover:bg-white/20 hover:scale-110 focus:outline-none focus:ring-2 focus:ring-white focus:ring-opacity-75 group/btn"
        aria-label="Imagen siguiente"
      >
        <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 transition-transform duration-300 group-hover/btn:translate-x-1" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
        </svg>
      </button>
    </>
  )}

  <!-- Enhanced Indicators -->
  {showIndicators && (
    <div class="absolute bottom-6 left-1/2 -translate-x-1/2 z-30">
      <div id="pagination-dots" class="flex items-center space-x-3 bg-black/20 backdrop-blur-md rounded-full px-4 py-2">
        {images.map((_, index) => (
          <button
            data-index={index}
            class="relative group/dot"
            aria-label={`Ir a imagen ${index + 1}`}
          >
            <div class="w-3 h-3 bg-white/40 rounded-full transition-all duration-500 hover:bg-white/70 hover:scale-125 focus:outline-none focus:ring-2 focus:ring-white focus:ring-opacity-75"></div>
            <div class="absolute inset-0 w-3 h-3 bg-white rounded-full scale-0 group-hover/dot:scale-150 group-hover/dot:bg-white/80 transition-all duration-300"></div>
          </button>
        ))}
      </div>

      <!-- Slide Counter -->
      <div class="text-center mt-3">
        <span id="slide-counter" class="text-white/80 text-sm font-medium bg-black/20 backdrop-blur-md px-3 py-1 rounded-full">
          1 / {images.length}
        </span>
      </div>
    </div>
  )}

  <!-- Enhanced Loading Animation -->
  <div id="loading-overlay" class="absolute inset-0 bg-gradient-to-br from-black/60 via-black/50 to-black/40 backdrop-blur-md flex items-center justify-center opacity-100 transition-all duration-700 z-40">
    <div class="flex flex-col items-center space-y-6 text-center">
      <!-- Animated Logo/Icon -->
      <div class="relative">
        <div class="w-16 h-16 border-4 border-white/20 border-t-white/80 border-r-white/60 rounded-full animate-spin"></div>
        <div class="absolute inset-2 w-12 h-12 border-2 border-white/10 border-b-white/40 rounded-full animate-spin" style="animation-direction: reverse; animation-duration: 1.5s;"></div>
      </div>
      
      <!-- Loading Text with Animation -->
      <div class="space-y-2">
        <p id="loading-text" class="text-white/90 text-lg font-semibold tracking-wide animate-pulse">Cargando imágenes...</p>
        <p class="text-white/60 text-sm">Preparando la mejor experiencia visual</p>
      </div>
      
      <!-- Enhanced Progress Bar -->
      <div class="w-64 space-y-2">
        <div class="w-full h-3 bg-white/10 rounded-full overflow-hidden shadow-inner">
          <div id="loading-progress" class="h-full bg-gradient-to-r from-blue-400 via-purple-500 to-pink-500 rounded-full transition-all duration-500 ease-out shadow-lg" style="width: 0%"></div>
        </div>
        <div class="flex justify-between text-white/50 text-xs">
          <span>Optimizando...</span>
          <span id="progress-percentage">0%</span>
        </div>
      </div>
    </div>
  </div>
</div>

<script type="module">
  class ProfessionalCarousel {
    constructor() {
      this.carousel = document.getElementById('carousel');
      this.inner = document.getElementById('carousel-inner');
      this.prevBtn = document.getElementById('prevBtn');
      this.nextBtn = document.getElementById('nextBtn');
      this.paginationDotsContainer = document.getElementById('pagination-dots');
      this.progressBar = document.getElementById('progress-bar');
      this.slideCounter = document.getElementById('slide-counter');
      this.loadingOverlay = document.getElementById('loading-overlay');
      this.loadingText = document.getElementById('loading-text');
      this.loadingProgress = document.getElementById('loading-progress');
      this.progressPercentage = document.getElementById('progress-percentage');

      this.dots = this.paginationDotsContainer ? Array.from(this.paginationDotsContainer.children) : [];
      this.slides = Array.from(this.inner.children);
      this.totalImages = this.slides.length;
      this.current = 0;
      this.autoSlideInterval = null;
      this.progressInterval = null;
      this.isTransitioning = false;
      this.touchStartX = 0;
      this.touchEndX = 0;
      
      // Métricas de rendimiento
      this.performanceMetrics = {
        startTime: performance.now(),
        firstImageLoaded: null,
        allCriticalImagesLoaded: null,
        carouselReady: null,
        totalLoadTime: null
      };

      this.init();
    }

    init() {
      this.setupEventListeners();
      this.updateCarousel();
      this.setupIntersectionObserver();
      this.waitForImagesAndStart();
      this.setupTouchEvents();
    }

    setupIntersectionObserver() {
      // Observar cuando el carousel entra en el viewport
      this.carouselObserver = new IntersectionObserver((entries) => {
        entries.forEach(entry => {
          if (entry.isIntersecting) {
            // Carousel visible, iniciar precarga agresiva
            this.isCarouselVisible = true;
            this.preloadVisibleImages();
          } else {
            // Carousel no visible, pausar auto-slide para ahorrar recursos
            this.isCarouselVisible = false;
            if (this.autoSlideInterval) {
              clearInterval(this.autoSlideInterval);
            }
          }
        });
      }, {
        threshold: 0.1, // Activar cuando 10% del carousel sea visible
        rootMargin: '50px' // Precargar 50px antes de que sea visible
      });
      
      this.carouselObserver.observe(this.carousel);
    }

    preloadVisibleImages() {
      // Precargar imágenes que están cerca del slide actual
      const preloadRange = 2; // Precargar 2 slides antes y después
      
      for (let i = -preloadRange; i <= preloadRange; i++) {
        const index = (this.current + i + this.totalImages) % this.totalImages;
        const slide = this.slides[index];
        
        if (slide) {
          const img = slide.querySelector('img');
          if (img && !img.complete) {
            this.preloadImage(img);
          }
        }
      }
    }

    async waitForImagesAndStart() {
      try {
        // Precarga inteligente: solo esperar las primeras 2 imágenes críticas
        const criticalImages = this.carousel.querySelectorAll('img[data-carousel-index="0"], img[data-carousel-index="1"]');
        const allCriticalLoaded = Array.from(criticalImages).every(img => img.complete && img.naturalHeight !== 0);
        
        if (allCriticalLoaded && criticalImages.length > 0) {
          // Si las críticas están cargadas, iniciar inmediatamente
          if (this.loadingText) {
            this.loadingText.textContent = 'Imágenes principales cargadas';
          }
          if (this.loadingProgress) {
            this.loadingProgress.style.width = '100%';
          }
          setTimeout(() => {
            this.hideLoadingOverlay();
            this.startAutoSlide();
            // Precargar el resto en segundo plano
            this.preloadRemainingImages();
          }, 200);
        } else {
          // Solo esperar las imágenes críticas
          await this.waitForCriticalImages();
          this.hideLoadingOverlay();
          this.startAutoSlide();
          // Precargar el resto en segundo plano
          this.preloadRemainingImages();
        }
      } catch (error) {
        console.warn('Error cargando imágenes críticas:', error);
        // Iniciar de todos modos después de 2 segundos
        setTimeout(() => {
          this.hideLoadingOverlay();
          this.startAutoSlide();
        }, 2000);
      }
    }

    waitForCriticalImages() {
       return new Promise((resolve, reject) => {
         const criticalImages = this.carousel.querySelectorAll('img[data-carousel-index="0"], img[data-carousel-index="1"]');
         let loadedCount = 0;
         let errorCount = 0;
         const totalImages = criticalImages.length;

         if (totalImages === 0) {
           resolve();
           return;
         }

         const updateProgress = () => {
           const progress = ((loadedCount + errorCount) / totalImages) * 100;
           if (this.loadingProgress) {
             this.loadingProgress.style.width = `${progress}%`;
           }
           if (this.progressPercentage) {
             this.progressPercentage.textContent = `${Math.round(progress)}%`;
           }
           if (this.loadingText) {
             if (progress < 50) {
               this.loadingText.textContent = `Cargando imágenes principales... ${loadedCount}/${totalImages}`;
             } else if (progress < 100) {
               this.loadingText.textContent = `Casi listo... ${loadedCount}/${totalImages}`;
             } else {
               this.loadingText.textContent = 'Imágenes principales listas';
             }
           }
         };

         const checkComplete = () => {
           updateProgress();
           if (loadedCount + errorCount >= totalImages) {
             if (this.loadingText) {
               this.loadingText.textContent = errorCount > 0 ? 
                 `Cargadas ${loadedCount}/${totalImages} imágenes principales` : 
                 'Imágenes principales listas';
             }
             
             setTimeout(() => {
               // Registrar tiempo de carga de imágenes críticas
               this.performanceMetrics.allCriticalImagesLoaded = performance.now();
               
               if (errorCount > 0 && loadedCount === 0) {
                 reject(new Error(`No se pudieron cargar ${errorCount} imágenes críticas`));
               } else {
                 resolve();
               }
             }, 300);
           }
         };

         // Inicializar progreso
         updateProgress();

         criticalImages.forEach((img) => {
           if (img.complete && img.naturalHeight !== 0) {
             loadedCount++;
             checkComplete();
           } else {
             img.addEventListener('load', () => {
               loadedCount++;
               // Registrar primera imagen cargada
               if (!this.performanceMetrics.firstImageLoaded) {
                 this.performanceMetrics.firstImageLoaded = performance.now();
               }
               checkComplete();
             });
             
             img.addEventListener('error', () => {
               errorCount++;
               console.warn('Error cargando imagen crítica:', img.src);
               checkComplete();
             });

             // Timeout reducido para imágenes críticas (4 segundos)
             setTimeout(() => {
               if (!img.complete) {
                 errorCount++;
                 console.warn('Timeout cargando imagen crítica:', img.src);
                 checkComplete();
               }
             }, 4000);
           }
         });
       });
     }

    preloadRemainingImages() {
      // Precargar imágenes no críticas en segundo plano
      const remainingImages = this.carousel.querySelectorAll('img:not([data-carousel-index="0"]):not([data-carousel-index="1"])');
      
      remainingImages.forEach((img, index) => {
        // Usar requestIdleCallback para no bloquear el hilo principal
        if (window.requestIdleCallback) {
          window.requestIdleCallback(() => {
            this.preloadImage(img);
          }, { timeout: 2000 });
        } else {
          // Fallback para navegadores sin soporte
          setTimeout(() => {
            this.preloadImage(img);
          }, 100 * (index + 1));
        }
      });
    }

    preloadImage(img) {
      if (!img.complete && img.src) {
        const preloader = new Image();
        preloader.onload = () => {
          console.log('Imagen precargada:', img.src);
        };
        preloader.onerror = () => {
           console.warn('Error precargando imagen:', img.src);
         };
        preloader.src = img.src;
        if (img.srcset) {
          preloader.srcset = img.srcset;
        }
      }
    }

    hideLoadingOverlay() {
      if (this.loadingOverlay) {
        // Animación de salida más elegante
        this.loadingOverlay.style.opacity = '0';
        this.loadingOverlay.style.transform = 'scale(0.95)';
        this.loadingOverlay.style.filter = 'blur(2px)';
        
        setTimeout(() => {
          this.loadingOverlay.style.display = 'none';
          // Mostrar el carousel con una entrada suave
          this.carousel.style.opacity = '0';
          this.carousel.style.transform = 'translateY(20px)';
          
          requestAnimationFrame(() => {
            this.carousel.style.transition = 'opacity 0.8s ease-out, transform 0.8s ease-out';
            this.carousel.style.opacity = '1';
            this.carousel.style.transform = 'translateY(0)';
            
            // Registrar tiempo final y mostrar métricas
            this.performanceMetrics.carouselReady = performance.now();
            this.performanceMetrics.totalLoadTime = this.performanceMetrics.carouselReady - this.performanceMetrics.startTime;
            this.logPerformanceMetrics();
          });
        }, 700);
      }
    }

    updateCarousel(smooth = true) {
      if (this.isTransitioning) return;
      this.isTransitioning = true;

      // Update transform with smooth transition
      this.inner.style.transition = smooth ? 'transform 1s cubic-bezier(0.4, 0, 0.2, 1)' : 'none';
      this.inner.style.transform = `translateX(-${this.current * 100}%)`;

      // Update indicators
      this.updateIndicators();

      // Update slide counter
      if (this.slideCounter) {
        this.slideCounter.textContent = `${this.current + 1} / ${this.totalImages}`;
      }

      // Preload next image for better performance
      this.preloadNextImage();

      // Reset transition flag after animation
      setTimeout(() => {
        this.isTransitioning = false;
      }, 1000);
    }

    updateIndicators() {
      this.dots.forEach((dot, index) => {
        const innerDot = dot.querySelector('div:first-child');
        if (index === this.current) {
          dot.classList.add('active');
          innerDot.classList.remove('bg-white/40', 'hover:bg-white/70');
          innerDot.classList.add('bg-white', 'scale-125');
        } else {
          dot.classList.remove('active');
          innerDot.classList.remove('bg-white', 'scale-125');
          innerDot.classList.add('bg-white/40', 'hover:bg-white/70');
        }
      });
    }

    preloadNextImage() {
      // Precargar las próximas 2 imágenes para navegación fluida
      const nextIndex = (this.current + 1) % this.totalImages;
      const nextNextIndex = (this.current + 2) % this.totalImages;
      
      [nextIndex, nextNextIndex].forEach(index => {
        const slide = this.slides[index];
        if (slide) {
          const img = slide.querySelector('img');
          if (img && !img.complete) {
            this.preloadImage(img);
          }
        }
      });
    }

    updateProgressBar() {
      if (!this.progressBar) return;

      let progress = 0;
      const duration = 5000; // 5 seconds
      const interval = 50; // Update every 50ms
      const increment = (interval / duration) * 100;

      clearInterval(this.progressInterval);
      this.progressInterval = setInterval(() => {
        progress += increment;
        if (progress >= 100) {
          progress = 100;
          clearInterval(this.progressInterval);
        }
        this.progressBar.style.width = `${progress}%`;
      }, interval);
    }

    startAutoSlide() {
      // Solo iniciar auto-slide si el carousel es visible
      if (!this.isCarouselVisible) {
        return;
      }
      
      clearInterval(this.autoSlideInterval);
      this.updateProgressBar();

      this.autoSlideInterval = setInterval(() => {
        // Verificar visibilidad antes de cada transición
        if (this.isCarouselVisible) {
          this.next();
        }
      }, 5000);
    }

    next() {
      this.current = (this.current + 1) % this.totalImages;
      this.updateCarousel();
      this.startAutoSlide();
    }

    prev() {
      this.current = (this.current - 1 + this.totalImages) % this.totalImages;
      this.updateCarousel();
      this.startAutoSlide();
    }

    goToSlide(index) {
      if (index !== this.current) {
        this.current = index;
        this.updateCarousel();
        this.startAutoSlide();
      }
    }

    setupEventListeners() {
      // Navigation buttons
      if (this.prevBtn) {
        this.prevBtn.addEventListener('click', () => this.prev());
      }

      if (this.nextBtn) {
        this.nextBtn.addEventListener('click', () => this.next());
      }

      // Pagination dots
      this.dots.forEach((dot, index) => {
        dot.addEventListener('click', () => this.goToSlide(index));
      });

      // Pause on hover
      this.carousel.addEventListener('mouseenter', () => {
        clearInterval(this.autoSlideInterval);
        clearInterval(this.progressInterval);
        if (this.progressBar) {
          this.progressBar.style.transition = 'width 0.3s ease-out';
          this.progressBar.style.width = '0%';
        }
      });

      this.carousel.addEventListener('mouseleave', () => this.startAutoSlide());

      // Limpiar observer al destruir el componente
      window.addEventListener('beforeunload', () => {
        if (this.carouselObserver) {
          this.carouselObserver.disconnect();
        }
      });

      // Keyboard navigation
      document.addEventListener('keydown', (e) => {
        if (e.key === 'ArrowLeft') {
          this.prev();
        } else if (e.key === 'ArrowRight') {
          this.next();
        }
      });
    }

    setupTouchEvents() {
      this.carousel.addEventListener('touchstart', (e) => {
        this.touchStartX = e.changedTouches[0].screenX;
      });

      this.carousel.addEventListener('touchend', (e) => {
        this.touchEndX = e.changedTouches[0].screenX;
        this.handleSwipe();
      });
    }

    handleSwipe() {
      const swipeThreshold = 50;
      const swipeDistance = this.touchStartX - this.touchEndX;

      if (Math.abs(swipeDistance) > swipeThreshold) {
        if (swipeDistance > 0) {
          this.next(); // Swipe left
        } else {
          this.prev(); // Swipe right
        }
      }
    }
    
    logPerformanceMetrics() {
      const metrics = this.performanceMetrics;
      const firstImageTime = metrics.firstImageLoaded ? (metrics.firstImageLoaded - metrics.startTime).toFixed(2) : 'N/A';
      const criticalImagesTime = metrics.allCriticalImagesLoaded ? (metrics.allCriticalImagesLoaded - metrics.startTime).toFixed(2) : 'N/A';
      const totalTime = metrics.totalLoadTime ? metrics.totalLoadTime.toFixed(2) : 'N/A';
      
      console.group('🎠 Métricas de Rendimiento del Carousel');
      console.log(`⚡ Primera imagen cargada: ${firstImageTime}ms`);
      console.log(`🖼️ Imágenes críticas cargadas: ${criticalImagesTime}ms`);
      console.log(`✅ Carousel completamente listo: ${totalTime}ms`);
      console.groupEnd();
    }
  }

  // Initialize carousel when DOM is loaded
  document.addEventListener('DOMContentLoaded', () => {
    new ProfessionalCarousel();
  });

  // Also initialize on Astro page load
  document.addEventListener('astro:page-load', () => {
    new ProfessionalCarousel();
  });
</script>
