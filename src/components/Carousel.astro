---
import Image from '~/components/common/Image.astro';

export interface Props {
  images: { src: string; alt: string }[];
  autoPlay?: boolean;
  autoPlayInterval?: number;
  showIndicators?: boolean;
  showArrows?: boolean;
  showProgress?: boolean;
}

const {
  images,
  showIndicators = true,
  showArrows = true,
  showProgress = true
} = Astro.props;
---

<div id="carousel" class="relative left-1/2 right-1/2 -mx-[50vw] w-screen overflow-hidden mt-4 mb-8 group">
  <!-- Progress Bar -->
  {showProgress && (
    <div class="absolute top-0 left-0 right-0 z-20">
      <div id="progress-bar" class="h-1 bg-gradient-to-r from-primary to-secondary transition-all duration-300 ease-out" style="width: 0%"></div>
    </div>
  )}

  <!-- Main Carousel Container -->
  <div class="relative overflow-hidden rounded-2xl shadow-2xl">
    <div id="carousel-inner" class="flex transition-transform duration-1000 ease-out h-[320px] sm:h-[400px] md:h-[480px] lg:h-[540px] xl:h-[600px]">
      {images.map(({ src, alt }, index) => (
        <div class="relative flex-shrink-0 w-full h-full group/slide">
          <Image
            src={src}
            alt={alt}
            width={1920}
            height={520}
            sizes="100vw"
            widths={[640, 768, 1024, 1280, 1536, 1920]}
            aspectRatio="3.7:1"
            class="absolute inset-0 w-full h-full object-cover transition-transform duration-1000 ease-out group-hover/slide:scale-105"
            data-carousel-index={index}
            loading={index === 0 ? 'eager' : 'lazy'}
          />

          <!-- Overlay oscuro sutil para legibilidad del texto -->
          <div class="absolute inset-0 bg-gradient-to-t from-black/70 via-black/30 to-black/40"></div>

        </div>
      ))}
    </div>

    <!-- Side Gradients for Depth -->
    <div class="pointer-events-none absolute inset-y-0 left-0 w-16 sm:w-32 bg-gradient-to-r from-black/40 to-transparent z-10"></div>
    <div class="pointer-events-none absolute inset-y-0 right-0 w-16 sm:w-32 bg-gradient-to-l from-black/40 to-transparent z-10"></div>

    <!-- Overlay oscuro general para legibilidad del banner -->
    <div class="pointer-events-none absolute inset-0 bg-black/35 z-[5]"></div>
  </div>

  <!-- Navigation Arrows -->
  {showArrows && (
    <>
      <button
        id="prevBtn"
        class="absolute left-6 top-1/2 -translate-y-1/2 z-30 bg-white/10 backdrop-blur-md text-white p-4 rounded-full shadow-xl opacity-0 group-hover:opacity-100 transition-all duration-500 hover:bg-white/20 hover:scale-110 focus:outline-none focus:ring-2 focus:ring-white focus:ring-opacity-75 group/btn"
        aria-label="Imagen anterior"
      >
        <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 transition-transform duration-300 group-hover/btn:-translate-x-1" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
        </svg>
      </button>
      <button
        id="nextBtn"
        class="absolute right-6 top-1/2 -translate-y-1/2 z-30 bg-white/10 backdrop-blur-md text-white p-4 rounded-full shadow-xl opacity-0 group-hover:opacity-100 transition-all duration-500 hover:bg-white/20 hover:scale-110 focus:outline-none focus:ring-2 focus:ring-white focus:ring-opacity-75 group/btn"
        aria-label="Imagen siguiente"
      >
        <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 transition-transform duration-300 group-hover/btn:translate-x-1" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
        </svg>
      </button>
    </>
  )}

  <!-- Enhanced Indicators -->
  {showIndicators && (
    <div class="absolute bottom-6 left-1/2 -translate-x-1/2 z-30">
      <div id="pagination-dots" class="flex items-center space-x-3 bg-black/20 backdrop-blur-md rounded-full px-4 py-2">
        {images.map((_, index) => (
          <button
            data-index={index}
            class="relative group/dot"
            aria-label={`Ir a imagen ${index + 1}`}
          >
            <div class="w-3 h-3 bg-white/40 rounded-full transition-all duration-500 hover:bg-white/70 hover:scale-125 focus:outline-none"></div>
          </button>
        ))}
      </div>

      <!-- Slide Counter -->
      <div class="text-center mt-3">
        <span id="slide-counter" class="text-white/80 text-sm font-medium bg-black/20 backdrop-blur-md px-3 py-1 rounded-full">
          1 / {images.length}
        </span>
      </div>
    </div>
  )}
</div>

<script>
  class Carousel {
    constructor() {
      this.carousel = document.getElementById('carousel');
      if (!this.carousel) return;
      this.inner = document.getElementById('carousel-inner');
      if (!this.inner) return;

      this.prevBtn = document.getElementById('prevBtn');
      this.nextBtn = document.getElementById('nextBtn');
      this.dotsContainer = document.getElementById('pagination-dots');
      this.progressBar = document.getElementById('progress-bar');
      this.slideCounter = document.getElementById('slide-counter');

      this.dots = this.dotsContainer ? Array.from(this.dotsContainer.children) : [];
      this.slides = Array.from(this.inner.children);
      this.total = this.slides.length;
      this.current = 0;
      this.autoInterval = null;
      this.progressTimer = null;
      this.transitioning = false;
      this.touchStartX = 0;
      this.visible = true;
      this._abortCtrl = new AbortController();

      this._init();
    }

    _init() {
      this._bindEvents();
      this._updateSlide(false);
      this._setupVisibilityObserver();
      this._startAuto();
    }

    destroy() {
      // Cancel all timers
      clearInterval(this.autoInterval);
      clearInterval(this.progressTimer);
      // Abort all event listeners
      this._abortCtrl.abort();
      // Disconnect observer
      if (this._observer) {
        this._observer.disconnect();
        this._observer = null;
      }
    }

    _bindEvents() {
      // Solo auto-play, sin navegación manual
    }

    _setupVisibilityObserver() {
      this._observer = new IntersectionObserver(
        ([entry]) => {
          this.visible = entry.isIntersecting;
          if (this.visible) {
            this._startAuto();
          } else {
            clearInterval(this.autoInterval);
            clearInterval(this.progressTimer);
          }
        },
        { threshold: 0.1 }
      );
      this._observer.observe(this.carousel);
    }

    _updateSlide(smooth = true) {
      if (this.transitioning) return;
      this.transitioning = true;

      this.inner.style.transition = smooth ? 'transform 0.8s cubic-bezier(0.4, 0, 0.2, 1)' : 'none';
      this.inner.style.transform = `translateX(-${this.current * 100}%)`;

      // Update indicators
      this.dots.forEach((dot, i) => {
        const circle = dot.querySelector('div');
        if (!circle) return;
        if (i === this.current) {
          circle.classList.remove('bg-white/40');
          circle.classList.add('bg-white', 'scale-125');
        } else {
          circle.classList.remove('bg-white', 'scale-125');
          circle.classList.add('bg-white/40');
        }
      });

      // Update counter
      if (this.slideCounter) {
        this.slideCounter.textContent = `${this.current + 1} / ${this.total}`;
      }

      setTimeout(() => { this.transitioning = false; }, 850);
    }

    _animateProgress() {
      if (!this.progressBar) return;
      clearInterval(this.progressTimer);
      let pct = 0;
      this.progressBar.style.width = '0%';
      this.progressTimer = setInterval(() => {
        pct += 1;
        if (pct >= 100) {
          pct = 100;
          clearInterval(this.progressTimer);
        }
        this.progressBar.style.width = `${pct}%`;
      }, 50);
    }

    _startAuto() {
      if (!this.visible) return;
      clearInterval(this.autoInterval);
      this._animateProgress();
      this.autoInterval = setInterval(() => {
        if (this.visible) this.next();
      }, 5000);
    }

    next() {
      this.current = (this.current + 1) % this.total;
      this._updateSlide();
      this._startAuto();
    }

    prev() {
      this.current = (this.current - 1 + this.total) % this.total;
      this._updateSlide();
      this._startAuto();
    }

    goTo(index) {
      if (index !== this.current) {
        this.current = index;
        this._updateSlide();
        this._startAuto();
      }
    }
  }

  // --- Lifecycle: singleton con cleanup ---
  let instance = null;

  function init() {
    if (instance) instance.destroy();
    instance = new Carousel();
  }

  // Limpiar al salir (ViewTransitions)
  document.addEventListener('astro:before-swap', () => {
    if (instance) {
      instance.destroy();
      instance = null;
    }
  });

  // Inicializar en cada carga de página
  document.addEventListener('astro:page-load', init);
</script>
