---
import { getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';

export interface Props {
  images: { src: string | ImageMetadata; alt: string }[];
  autoPlay?: boolean;
  autoPlayInterval?: number;
  showProgress?: boolean;
  showArrows?: boolean;
}

const {
  images,
  showProgress = true,
  autoPlay = true,
  autoPlayInterval = 6000,
  showArrows = true,
} = Astro.props;

// Optimizar todas las imágenes del carrusel con Sharp a formato WebP full-width (1920px)
const optimizedImages = await Promise.all(
  images.map(async ({ src, alt }) => {
    if (typeof src === 'object' && src !== null && 'src' in src) {
      const opt = await getImage({
        src: src as ImageMetadata,
        width: 1920,
        format: 'webp',
        quality: 80,
      });
      return {
        src: opt.src,
        alt,
      };
    }
    return {
      src: typeof src === 'string' ? src : (src as any).src,
      alt,
    };
  })
);
---

<div id="carousel" class="relative left-1/2 right-1/2 -mx-[50vw] w-screen overflow-hidden mt-4 mb-8 group" data-interval={autoPlayInterval} data-autoplay={autoPlay ? 'true' : 'false'}>
  <!-- Progress Bar (Acelerado por GPU) -->
  {showProgress && (
    <div class="absolute top-0 left-0 right-0 z-20 h-1 overflow-hidden pointer-events-none">
      <div id="progress-bar" class="h-full w-full bg-gradient-to-r from-primary to-secondary origin-left transform scale-x-0" style="will-change: transform;"></div>
    </div>
  )}

  <!-- Main Carousel Container -->
  <div class="relative overflow-hidden rounded-2xl shadow-2xl w-full">
    <div id="carousel-inner" class="flex transition-transform duration-1000 ease-out h-[320px] sm:h-[400px] md:h-[480px] lg:h-[540px] xl:h-[600px] w-full">
      {optimizedImages.map(({ src, alt }, index) => (
        <div class="relative flex-shrink-0 w-full h-full group/slide overflow-hidden">
          <img
            src={src}
            alt={alt}
            width="1920"
            height="600"
            class="absolute inset-0 w-full h-full object-cover transition-transform duration-1000 ease-out group-hover/slide:scale-105"
            style="width: 100% !important; min-width: 100% !important; max-width: none !important; height: 100% !important; min-height: 100% !important; max-height: none !important; object-fit: cover !important;"
            data-carousel-index={index}
            loading={index === 0 ? 'eager' : 'lazy'}
            fetchpriority={index === 0 ? 'high' : 'low'}
            decoding="async"
          />

          <!-- Overlay oscuro sutil para legibilidad del texto en todo el ancho -->
          <div class="absolute inset-0 bg-gradient-to-t from-black/70 via-black/30 to-black/40 pointer-events-none"></div>
        </div>
      ))}
    </div>

    <!-- Flechas de navegación (visibles en hover en desktop) -->
    {showArrows && (
      <>
        <button
          id="prevBtn"
          type="button"
          class="absolute left-4 top-1/2 -translate-y-1/2 z-20 p-2.5 rounded-full bg-black/40 hover:bg-black/70 text-white backdrop-blur-md opacity-0 group-hover:opacity-100 transition-all duration-300 hover:scale-110 focus:outline-none"
          aria-label="Imagen anterior"
        >
          <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7" />
          </svg>
        </button>
        <button
          id="nextBtn"
          type="button"
          class="absolute right-4 top-1/2 -translate-y-1/2 z-20 p-2.5 rounded-full bg-black/40 hover:bg-black/70 text-white backdrop-blur-md opacity-0 group-hover:opacity-100 transition-all duration-300 hover:scale-110 focus:outline-none"
          aria-label="Imagen siguiente"
        >
          <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
          </svg>
        </button>
      </>
    )}

    <!-- Side Gradients for Depth -->
    <div class="pointer-events-none absolute inset-y-0 left-0 w-16 sm:w-32 bg-gradient-to-r from-black/40 to-transparent z-10"></div>
    <div class="pointer-events-none absolute inset-y-0 right-0 w-16 sm:w-32 bg-gradient-to-l from-black/40 to-transparent z-10"></div>

    <!-- Overlay oscuro general para legibilidad del banner -->
    <div class="pointer-events-none absolute inset-0 bg-black/35 z-[5]"></div>
  </div>
</div>

<script>
  class Carousel {
    constructor() {
      this.carousel = document.getElementById('carousel');
      if (!this.carousel) return;
      this.inner = document.getElementById('carousel-inner');
      if (!this.inner) return;

      this.progressBar = document.getElementById('progress-bar');
      this.prevBtn = document.getElementById('prevBtn');
      this.nextBtn = document.getElementById('nextBtn');
      this.slides = Array.from(this.inner.children);
      this.total = this.slides.length;
      this.current = 0;
      this.autoInterval = null;
      this.transitioning = false;
      this.touchStartX = 0;
      this.visible = true;
      this._isHovered = false;
      this._abortCtrl = new AbortController();

      const rawInterval = this.carousel.getAttribute('data-interval');
      this.interval = rawInterval ? parseInt(rawInterval, 10) : 6000;
      this.autoPlay = this.carousel.getAttribute('data-autoplay') !== 'false';

      this._init();
    }

    _init() {
      this._bindEvents();
      this._updateSlide(false);
      this._setupVisibilityObserver();
      if (this.autoPlay) {
        this._startAuto();
      }
    }

    destroy() {
      if (this.autoInterval) clearInterval(this.autoInterval);
      if (this._abortCtrl) {
        this._abortCtrl.abort();
        this._abortCtrl = null;
      }
      if (this._observer) {
        this._observer.disconnect();
        this._observer = null;
      }
    }

    _bindEvents() {
      const signal = this._abortCtrl.signal;

      if (this.prevBtn) {
        this.prevBtn.addEventListener('click', (e) => {
          e.preventDefault();
          this.prev();
        }, { signal });
      }

      if (this.nextBtn) {
        this.nextBtn.addEventListener('click', (e) => {
          e.preventDefault();
          this.next();
        }, { signal });
      }

      this.carousel.addEventListener('mouseenter', () => {
        this._isHovered = true;
        clearInterval(this.autoInterval);
        this._pauseProgress();
      }, { signal });

      this.carousel.addEventListener('mouseleave', () => {
        this._isHovered = false;
        if (this.autoPlay) {
          this._startAuto();
        }
      }, { signal });

      this.carousel.addEventListener(
        'touchstart',
        (e) => {
          this.touchStartX = e.touches[0].clientX;
        },
        { passive: true, signal }
      );

      this.carousel.addEventListener(
        'touchend',
        (e) => {
          const touchEndX = e.changedTouches[0].clientX;
          const diffX = this.touchStartX - touchEndX;
          if (Math.abs(diffX) > 45) {
            if (diffX > 0) {
              this.next();
            } else {
              this.prev();
            }
          }
        },
        { passive: true, signal }
      );
    }

    _setupVisibilityObserver() {
      this._observer = new IntersectionObserver(
        ([entry]) => {
          this.visible = entry.isIntersecting;
          if (this.visible && !this._isHovered && this.autoPlay) {
            this._startAuto();
          } else {
            clearInterval(this.autoInterval);
            this._pauseProgress();
          }
        },
        { threshold: 0.1 }
      );
      this._observer.observe(this.carousel);
    }

    _updateSlide(smooth = true) {
      if (this.transitioning) return;
      this.transitioning = true;

      this.inner.style.transition = smooth ? 'transform 0.8s cubic-bezier(0.4, 0, 0.2, 1)' : 'none';
      this.inner.style.transform = `translateX(-${this.current * 100}%)`;

      setTimeout(() => { this.transitioning = false; }, 850);
    }

    _animateProgress() {
      if (!this.progressBar) return;
      this.progressBar.style.transition = 'none';
      this.progressBar.style.transform = 'scaleX(0)';

      void this.progressBar.offsetWidth;

      this.progressBar.style.transition = `transform ${this.interval}ms linear`;
      this.progressBar.style.transform = 'scaleX(1)';
    }

    _pauseProgress() {
      if (!this.progressBar) return;
      const computed = window.getComputedStyle(this.progressBar).transform;
      this.progressBar.style.transition = 'none';
      this.progressBar.style.transform = computed;
    }

    _startAuto() {
      if (!this.visible) return;
      clearInterval(this.autoInterval);
      this._animateProgress();
      this.autoInterval = setInterval(() => {
        if (this.visible) this.next();
      }, this.interval);
    }

    next() {
      this.current = (this.current + 1) % this.total;
      this._updateSlide();
      if (this.autoPlay) {
        this._startAuto();
      }
    }

    prev() {
      this.current = (this.current - 1 + this.total) % this.total;
      this._updateSlide();
      if (this.autoPlay) {
        this._startAuto();
      }
    }

    goTo(index) {
      if (index !== this.current) {
        this.current = index;
        this._updateSlide();
        if (this.autoPlay) {
          this._startAuto();
        }
      }
    }
  }

  let instance = null;

  function init() {
    if (instance) {
      instance.destroy();
      instance = null;
    }
    const carouselEl = document.getElementById('carousel');
    if (carouselEl) {
      instance = new Carousel();
    }
  }

  document.addEventListener('astro:before-swap', () => {
    if (instance) {
      instance.destroy();
      instance = null;
    }
  });

  document.addEventListener('astro:page-load', init);
</script>
