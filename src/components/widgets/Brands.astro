---
import { Icon } from 'astro-icon/components';
import type { Brands as Props } from '~/types';

import Image from '~/components/common/Image.astro';
import Headline from '~/components/ui/Headline.astro';
import WidgetWrapper from '~/components/ui/WidgetWrapper.astro';
const {
  title = '',
  subtitle = '',
  tagline = '',
  icons = [],
  images = [],
  id,
  isDark = false,
  classes = {},
  bg = await Astro.slots.render('bg'),
} = Astro.props;
---

<WidgetWrapper id={id} isDark={isDark} containerClass={`max-w-6xl mx-auto ${classes?.container ?? ''}`} bg={bg}>
  <Headline title={title} subtitle={subtitle} tagline={tagline} />

  <div
    class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5 gap-x-8 gap-y-6 items-center justify-items-center"
  >
    {
      icons &&
        icons.map((icon, index) => (
          <Icon
            name={icon}
            class={`py-4 lg:py-6 w-14 h-auto mx-auto sm:mx-0 text-primary hover:text-secondary transition-all duration-300 icon-bounce icon-glow stagger-${(index % 8) + 1} animate-fade-in-up`}
          />
        ))
    }
    {
      images &&
        images.map(
          (image, index) =>
            image.src && (
              <div
                class="flex items-center justify-center p-3 sm:p-4 rounded-xl bg-white dark:bg-slate-800/80 border border-gray-200/80 dark:border-slate-700 hover:border-primary/60 dark:hover:border-primary/60 transition-colors duration-200 cursor-pointer h-full"
                onclick={image.onclick}
              >
                <Image
                  src={image.src}
                  alt={image.alt || ''}
                  width={120}
                  height={56}
                  layout="constrained"
                  loading="lazy"
                  sizes="(max-width: 768px) 60px, 120px"
                  widths={[60, 120]}
                  class="max-h-12 w-auto object-contain transition-opacity duration-200 hover:opacity-85"
                />
              </div>
            )
        )
    }
  </div>
</WidgetWrapper>
