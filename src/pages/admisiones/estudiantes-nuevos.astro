---
import PageLayout from '~/layouts/PageLayout.astro';
import Breadcrumbs from '~/components/ui/Breadcrumbs.astro';
import { Icon } from 'astro-icon/components';
import WhatsAppButton from '~/components/WhatsAppButton.astro';

const breadcrumbs = [
  { label: 'Inicio', href: '/' },
  { label: 'Admisiones', href: '/admisiones' },
  { label: 'Estudiantes Nuevos', href: '/admisiones/estudiantes-nuevos', current: true }
];
---

<PageLayout metadata={{ title: "Estudiantes Nuevos - Admisiones Colegio Juan Pablo II" }}>
  <main class="min-h-screen bg-gradient-to-br from-green-50 via-white to-blue-50 dark:from-slate-900 dark:via-slate-800 dark:to-slate-900">
    <!-- Breadcrumbs -->
    <div class="bg-gray-50 dark:bg-slate-900 border-b border-gray-200 dark:border-slate-700">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-4">
        <Breadcrumbs items={breadcrumbs} />
      </div>
    </div>

    <!-- Hero Section -->
    <section class="relative py-20 overflow-hidden">
      <div class="absolute inset-0 bg-gradient-to-r from-green-600/10 to-blue-600/10"></div>
      <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
        <div class="mb-8">
          <Icon name="tabler:user-plus" class="w-20 h-20 mx-auto text-green-600 mb-6" />
        </div>
        <h1 class="text-5xl md:text-6xl font-bold text-gray-900 dark:text-white mb-6 leading-tight">
          Estudiantes <span class="text-green-600">Nuevos</span>
        </h1>
        <p class="text-xl text-gray-600 dark:text-gray-300 max-w-3xl mx-auto leading-relaxed">
          Proceso de admisión y requisitos para estudiantes que ingresan por primera vez a nuestra institución
        </p>
      </div>
    </section>

    <!-- Estudiantes Nuevos Section -->
    <section id="estudiantes-nuevos" class="py-20">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 lg:gap-12 items-start mb-12 lg:mb-16">
            <!-- Left Column: Document Card and Form -->
            <div class="space-y-8">
              <!-- Document Card -->
              <div class="bg-white dark:bg-slate-800 rounded-2xl shadow-xl border border-gray-200 dark:border-slate-700 p-6 sm:p-8 hover:shadow-2xl transition-all duration-300">
                <div class="flex items-center mb-6">
                  <div class="w-16 h-16 bg-emerald-100 dark:bg-emerald-900/30 rounded-xl flex items-center justify-center mr-4">
                    <Icon name="tabler:user-plus" class="w-8 h-8 text-emerald-600" />
                  </div>
                  <div>
                    <h3 class="text-xl sm:text-2xl font-bold text-gray-900 dark:text-white">Guía Estudiantes Nuevos</h3>
                    <p class="text-sm sm:text-base text-gray-600 dark:text-gray-300">Proceso de admisión para nuevos estudiantes</p>
                  </div>
                </div>
                
                <div class="text-center">
                  <a
                    href="/files/Nuevos.pdf"
                    target="_blank"
                    class="inline-flex items-center gap-2 px-4 py-2 sm:px-6 sm:py-3 bg-purple-600 text-white rounded-lg hover:bg-purple-700 transition-colors duration-200 font-medium text-sm sm:text-base"
                  >
                    <Icon name="tabler:download" class="w-4 h-4 sm:w-5 sm:h-5" />
                    Descargar Guía
                  </a>
                </div>
              </div>

              <!-- Formulario ZIGMA -->
              <div class="bg-white dark:bg-slate-800 rounded-2xl shadow-xl border border-gray-200 dark:border-slate-700 p-6 sm:p-8 hover:shadow-2xl transition-all duration-300">
                <div class="flex items-center mb-6">
                  <div class="w-16 h-16 bg-green-100 dark:bg-green-900/30 rounded-xl flex items-center justify-center mr-4">
                    <Icon name="tabler:forms" class="w-8 h-8 text-green-600" />
                  </div>
                  <div>
                    <h3 class="text-xl sm:text-2xl font-bold text-gray-900 dark:text-white">Formulario de Inscripción</h3>
                    <p class="text-gray-600 dark:text-gray-300">Sistema ZIGMA para estudiantes nuevos</p>
                  </div>
                </div>
                
                <p class="text-sm sm:text-base text-gray-600 dark:text-gray-300 mb-4 sm:mb-6">
                  Complete el formulario de inscripción en línea a través de nuestro sistema ZIGMA para iniciar el proceso de admisión.
                </p>
                
                <div class="text-center">
                  <a
                    href="https://www.iejuanpabloii.notas.zigmadatos.org/index.php/admisiones-2024"
                    target="_blank"
                    class="inline-flex items-center gap-2 px-4 py-2 sm:px-6 sm:py-3 bg-green-600 text-white rounded-lg hover:bg-green-700 transition-colors duration-200 font-medium text-sm sm:text-base"
                  >
                    <Icon name="tabler:external-link" class="w-4 h-4 sm:w-5 sm:h-5" />
                    Acceder al Formulario
                  </a>
                </div>
              </div>
            </div>

            <!-- Right Column: PDF Viewer -->
            <div class="bg-white dark:bg-slate-800 rounded-2xl shadow-xl border border-gray-200 dark:border-slate-700 p-3 sm:p-4 lg:p-6">
              <div class="aspect-[4/5] w-full max-h-[600px]">
                <iframe
                  src="/files/Nuevos.pdf#toolbar=0&navpanes=0"
                  class="w-full h-full rounded-lg border border-gray-200 dark:border-slate-600"
                  loading="lazy"
                  title="Guía para Estudiantes Nuevos"
                ></iframe>
              </div>
            </div>
          </div>
      </div>
    </section>
  </main>
  
  <WhatsAppButton phoneNumber="573196721410" message="Hola, necesito información sobre admisiones para estudiantes nuevos." />
</PageLayout>