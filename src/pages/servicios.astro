---
import Classrooms from '~/components/widgets/Classrooms.astro';
import Content from '~/components/widgets/Content.astro';
import Features2 from '~/components/widgets/Features2.astro';
import Hero from '~/components/widgets/Hero.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';
import Headline from '~/components/ui/Headline.astro';
import Layout from '~/layouts/PageLayout.astro';
import WhatsAppButton from '~/components/WhatsAppButton.astro';
import Breadcrumbs from '~/components/ui/Breadcrumbs.astro';

const metadata = {
  title: 'Servicios Educativos | Instituto Psicopedagógico Juan Pablo II',
  description: 'Conoce nuestra oferta académica: preescolar, primaria, bachillerato, aulas especializadas, laboratorios y modelo de formación integral en Soacha.',
};

// Configuración de breadcrumbs
const breadcrumbItems = [
  { label: 'Inicio', href: '/' },
  { label: 'Servicios', current: true },
];
---

<Layout metadata={metadata}>
  <!-- Breadcrumbs Section -->
  <div class="relative z-20 bg-gray-50/80 dark:bg-slate-900/60 border-b border-gray-200/80 dark:border-gray-800">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-3">
      <Breadcrumbs items={breadcrumbItems} />
    </div>
  </div>

  <!-- Hero Widget ******************* -->
  <Hero
    tagline="Propuesta Educativa"
    title="Servicios para Crecer y Aprender"
    subtitle="En el Instituto Psicopedagógico Juan Pablo II brindamos una formación integral centrada en el ser humano, complementada con espacios vivenciales, lúdicos y tecnológicos que potencian el desarrollo de habilidades en cada etapa del educando."
    image={{
      src: '~/assets/images/SERVICIOS.png',
      alt: 'Servicios Educativos Juan Pablo II',
      class: 'mx-auto block rounded-2xl shadow-xl border border-gray-100 dark:border-gray-800 max-h-[500px] w-auto max-w-full object-contain bg-white/95 dark:bg-slate-900/60 p-3 sm:p-5',
    }}
  />

  <!-- Classrooms Widget (Aulas Especiales) ******************* -->
  <Classrooms
    isDark={true}
    title="Más Allá del Aula Tradicional"
    information="Diseñamos entornos de aprendizaje activo que despiertan la curiosidad, el ingenio y el trabajo en equipo. A través de la interacción práctica y la exploración sensorial, cultivamos talentos individuales en un ambiente motivador y seguro."
    items={[
      {
        image: '~/assets/images/BIBLIOTECA.webp',
        title: 'Biblioteca y Sala de Lectura',
        description:
          'Espacio acogedor con amplio catálogo bibliográfico y recursos didácticos para incentivar el hábito lector, la indagación y la comprensión crítica.',
      },
      {
        image: '~/assets/images/LABORATORIO.webp',
        title: 'Laboratorio Científico',
        description:
          'Dotado con instrumentos y materiales prácticos para experimentar, observar hipótesis y descubrir la ciencia de forma tangible y segura.',
      },
      {
        image: '~/assets/images/LUDOTECA.webp',
        title: 'Ludoteca y Expresión',
        description:
          'Ambiente lúdico-pedagógico pensado para desarrollar la psicomotricidad, las habilidades socioemocionales y la creatividad a través del juego.',
      },
      {
        image: '~/assets/images/SISTEMAS.webp',
        title: 'Sala de Sistemas & TIC',
        description:
          'Equipada con equipos de cómputo y plataformas digitales para el fortalecimiento de competencias tecnológicas y pensamiento algorítmico.',
      },
    ]}
  >
    <Fragment slot="bg">
      <div class="absolute inset-0 bg-gradient-to-b from-[#074628] via-[#0A5C36] to-[#063920] dark:from-slate-900 dark:via-slate-950 dark:to-slate-900"></div>
    </Fragment>
  </Classrooms>

  <!-- Features2 Widget (Niveles y Grados) ************** -->
  <section class="py-12 md:py-16 bg-gradient-subtle">
    <Features2
      title="Niveles de Formación Académica"
      subtitle="Acompañamos a nuestros educandos desde sus primeros pasos hasta su proyección profesional y ciudadana con un enfoque pedagógico personalizado y basado en valores."
      columns={3}
      items={[
        {
          title: 'PREESCOLAR (Educación Inicial)',
          description:
            'Sentamos las bases del aprendizaje a través del juego, la estimulación sensorial, el desarrollo del lenguaje y la socialización armónica.',
          icon: 'tabler:baby-carriage',
        },
        {
          title: 'BÁSICA PRIMARIA (1° - 5°)',
          description:
            'Consolidamos destrezas lógico-matemáticas, comprensión lectora, expresión oral y escrita, exploración del entorno y trabajo cooperativo.',
          icon: 'tabler:book',
        },
        {
          title: 'SECUNDARIA Y MEDIA (6° - 11°)',
          description:
            'Profundizamos en competencias analíticas, científicas y técnicas, preparando al joven para afrontar las pruebas de Estado y su ingreso a la educación superior.',
          icon: 'tabler:school',
        },
      ]}
    />
  </section>

  <!-- Separador / Encabezado de Áreas de Aprendizaje -->
  <div class="max-w-4xl mx-auto px-4 pt-16 pb-4 text-center" data-animate="animate-fade-in-up">
    <span class="inline-block px-3.5 py-1.5 rounded-full text-xs font-bold tracking-wider uppercase bg-primary/10 text-primary dark:bg-emerald-500/20 dark:text-emerald-300 mb-3">
      Plan de Estudios Integral
    </span>
    <h2 class="text-3xl sm:text-4xl md:text-5xl font-bold font-heading text-heading tracking-tight mb-4">
      Áreas de Aprendizaje y Desarrollo
    </h2>
    <p class="text-lg text-muted dark:text-slate-300 max-w-2xl mx-auto leading-relaxed">
      Estructuramos nuestro plan curricular en dos grandes núcleos para asegurar el balance perfecto entre razonamiento cognitivo, rigor analítico y formación humana sensible.
    </p>
  </div>

  <!-- Content Widget 1: Eje Humanístico y Lógico **************** -->
  <Content
    classes={{
      container: 'pt-8 md:pt-12',
    }}
    isReversed
    title="Núcleo Humanístico y Pensamiento Lógico"
    subtitle="Fortaleciendo la capacidad reflexiva, la precisión numérica y la apertura intercultural."
    items={[
      {
        title: 'Matemáticas y Razonamiento',
        description:
          'Cálculo, lógica cuantitativa y resolución de problemas cotidianos mediante el análisis espacial, geométrico y algebraico.',
        icon: 'tabler:calculator',
      },
      {
        title: 'Lectura Crítica',
        description:
          'Comprensión profunda de textos, interpretación de contextos y desarrollo del hábito lector transformador.',
        icon: 'tabler:book-2',
      },
      {
        title: 'Producción Textual y Escritura',
        description:
          'Redacción coherente, ortografía aplicada y capacidad argumentativa para comunicar ideas con claridad.',
        icon: 'tabler:pencil',
      },
      {
        title: 'Inglés como Segunda Lengua',
        description:
          'Inmersión progresiva en destrezas de habla, escucha y lectura para interactuar en un contexto global.',
        icon: 'tabler:language',
      },
      {
        title: 'Historia y Ciencias Sociales',
        description:
          'Comprensión del devenir histórico, identidad nacional, geografía y análisis de la sociedad contemporánea.',
        icon: 'tabler:history',
      },
    ]}
    image={{
      src: '~/assets/images/SERVICIOS1.webp',
      alt: 'Estudiantes en actividades de aprendizaje',
      class: 'rounded-2xl shadow-xl border-2 border-primary/20 hover:scale-[1.02] transition-transform duration-500 w-full max-w-md mx-auto',
    }}
  />

  <!-- Content Widget 2: Eje Científico y Artístico **************** -->
  <Content
    classes={{
      container: 'pt-8 md:pt-16',
    }}
    title="Núcleo Científico, Creativo y Ciudadano"
    subtitle="Despertando el espíritu investigativo, la sensibilidad artística y el compromiso con la comunidad."
    items={[
      {
        title: 'Comunicación y Lenguaje',
        description:
          'Uso ético y elocuente de la palabra, oratoria y expresión asertiva en público.',
        icon: 'tabler:message-2',
      },
      {
        title: 'Artes Plásticas y Música',
        description:
          'Exploración de la sensibilidad estética, pintura, ritmo y apreciación cultural de distintas épocas.',
        icon: 'tabler:palette',
      },
      {
        title: 'Biología y Educación Ambiental',
        description:
          'Estudio de los seres vivos, cuidado de la biodiversidad y proyectos ecológicos de conservación.',
        icon: 'tabler:leaf',
      },
      {
        title: 'Química Experimental',
        description:
          'Comportamiento de la materia, leyes de la transformación y aplicaciones científicas en el entorno.',
        icon: 'tabler:flask',
      },
      {
        title: 'Ética y Convivencia Ciudadana',
        description:
          'Dilemas éticos, toma responsable de decisiones, respeto a la diversidad y convivencia en paz.',
        icon: 'tabler:mood-heart',
      },
    ]}
    image={{
      src: '~/assets/images/SERVICIOS2.webp',
      alt: 'Talleres formativos y científicos',
      class: 'rounded-2xl shadow-xl border-2 border-primary/20 hover:scale-[1.02] transition-transform duration-500 w-full max-w-md mx-auto',
    }}
  />

  <!-- Call to Action Section **************** -->
  <section class="py-12 md:py-16" data-animate="animate-fade-in-up">
    <CallToAction
      title="¿Listo para dar el siguiente paso en la educación de tus hijos?"
      subtitle="Te invitamos a programar una visita guiada para conocer nuestras sedes, dialogar con los directivos y conocer nuestro proceso de admisión."
      actions={[
        {
          variant: 'primary',
          text: 'Proceso de Admisiones',
          href: '/admisiones',
          icon: 'tabler:arrow-right',
        },
        {
          text: 'Contactar por WhatsApp',
          href: 'https://wa.me/573196721410?text=Hola,%20deseo%20m%C3%A1s%20informaci%C3%B3n%20sobre%20los%20servicios%20educativos',
          icon: 'tabler:brand-whatsapp',
          target: '_blank',
        },
      ]}
    >
      <Fragment slot="bg">
        <div class="absolute inset-0 bg-emerald-50/70 dark:bg-slate-900/60 rounded-3xl border border-primary/10 dark:border-slate-800"></div>
      </Fragment>
    </CallToAction>
  </section>

  <!-- WhatsApp Floating Button -->
  <WhatsAppButton phoneNumber="573196721410" message="Hola, estoy interesado en sus servicios educativos." />
</Layout>
