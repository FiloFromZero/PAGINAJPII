---
import Layout from '~/layouts/PageLayout.astro';
import HeroText from '~/components/widgets/HeroText.astro';
import { Icon } from 'astro-icon/components';
import WhatsAppButton from '~/components/WhatsAppButton.astro';
import Breadcrumbs from '~/components/ui/Breadcrumbs.astro';

const metadata = {
  title: 'Admisiones',
};

// Configuración de breadcrumbs
const breadcrumbItems = [
  { label: 'Inicio', href: '/' },
  { label: 'Admisiones', current: true },
];
---

<Layout metadata={metadata}>
  <!-- Breadcrumbs Section -->
  <div class="relative z-20 bg-gray-50 dark:bg-gray-800 border-b border-gray-200 dark:border-gray-700">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-4">
      <Breadcrumbs items={breadcrumbItems} />
    </div>
  </div>

  <!-- HeroText Widget ******************* -->

  <HeroText tagline="Admisiones 2027" title="Inscripciones y Matrículas" subtitle="Conoce los pasos, requisitos y documentación para formar parte de la familia Juanpablina." />

  <!-- Secciones de Admisiones -->
  <section class="py-12 md:py-16">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6 lg:gap-8">
        <!-- Prospecto Institucional -->
        <div
          class="bg-white dark:bg-slate-800 rounded-2xl shadow-soft border border-gray-200/80 dark:border-slate-700/80 p-5 sm:p-6 hover:shadow-medium transition-all duration-300 flex flex-col justify-between"
          data-animate="animate-fade-in-up"
          data-tilt
          data-animate-delay="100"
        >
          <div>
            <div class="flex items-center mb-4">
              <div
                class="w-12 h-12 bg-emerald-50 dark:bg-emerald-950/50 rounded-xl flex items-center justify-center mr-3 border border-emerald-100 dark:border-emerald-800/40"
              >
                <Icon name="tabler:file-text" class="w-6 h-6 text-primary dark:text-emerald-400" />
              </div>
              <h3 class="text-lg font-bold font-heading text-heading dark:text-white">Prospecto</h3>
            </div>
            <p class="text-muted dark:text-slate-300 mb-5 text-sm leading-relaxed">
              Conoce nuestra propuesta educativa, proyecto pedagógico y programas académicos.
            </p>
          </div>
          <a
            href="/admisiones/prospecto"
            class="inline-flex items-center gap-2 px-4 py-2.5 bg-primary text-white rounded-xl hover:bg-secondary transition-colors duration-200 text-sm font-semibold w-full justify-center shadow-soft"
          >
            <span>Ver Prospecto</span>
            <Icon name="tabler:arrow-right" class="w-4 h-4" />
          </a>
        </div>

        <!-- Estudiantes Nuevos -->
        <div
          class="bg-white dark:bg-slate-800 rounded-2xl shadow-soft border border-gray-200/80 dark:border-slate-700/80 p-5 sm:p-6 hover:shadow-medium transition-all duration-300 flex flex-col justify-between"
          data-animate="animate-fade-in-up"
          data-tilt
          data-animate-delay="200"
        >
          <div>
            <div class="flex items-center mb-4">
              <div
                class="w-12 h-12 bg-amber-50 dark:bg-amber-950/50 rounded-xl flex items-center justify-center mr-3 border border-amber-100 dark:border-amber-800/40"
              >
                <Icon name="tabler:user-plus" class="w-6 h-6 text-accent dark:text-amber-400" />
              </div>
              <h3 class="text-lg font-bold font-heading text-heading dark:text-white">Estudiantes Nuevos</h3>
            </div>
            <p class="text-muted dark:text-slate-300 mb-5 text-sm leading-relaxed">
              Proceso paso a paso de admisión y requisitos para nuevos aspirantes Juanpablinos.
            </p>
          </div>
          <a
            href="/admisiones/estudiantes-nuevos"
            class="inline-flex items-center gap-2 px-4 py-2.5 bg-primary text-white rounded-xl hover:bg-secondary transition-colors duration-200 text-sm font-semibold w-full justify-center shadow-soft"
          >
            <span>Ver Proceso</span>
            <Icon name="tabler:arrow-right" class="w-4 h-4" />
          </a>
        </div>

        <!-- Estudiantes Antiguos -->
        <div
          class="bg-white dark:bg-slate-800 rounded-2xl shadow-soft border border-gray-200/80 dark:border-slate-700/80 p-5 sm:p-6 hover:shadow-medium transition-all duration-300 flex flex-col justify-between"
          data-animate="animate-fade-in-up"
          data-tilt
          data-animate-delay="300"
        >
          <div>
            <div class="flex items-center mb-4">
              <div
                class="w-12 h-12 bg-emerald-50 dark:bg-emerald-950/50 rounded-xl flex items-center justify-center mr-3 border border-emerald-100 dark:border-emerald-800/40"
              >
                <Icon name="tabler:users" class="w-6 h-6 text-primary dark:text-emerald-400" />
              </div>
              <h3 class="text-lg font-bold font-heading text-heading dark:text-white">Estudiantes Antiguos</h3>
            </div>
            <p class="text-muted dark:text-slate-300 mb-5 text-sm leading-relaxed">
              Renovación de matrícula, continuidad académica y reservas de cupo para el nuevo año.
            </p>
          </div>
          <a
            href="/admisiones/estudiantes-antiguos"
            class="inline-flex items-center gap-2 px-4 py-2.5 bg-primary text-white rounded-xl hover:bg-secondary transition-colors duration-200 text-sm font-semibold w-full justify-center shadow-soft"
          >
            <span>Ver Renovación</span>
            <Icon name="tabler:arrow-right" class="w-4 h-4" />
          </a>
        </div>

        <!-- Entrevista -->
        <div
          class="bg-white dark:bg-slate-800 rounded-2xl shadow-soft border border-gray-200/80 dark:border-slate-700/80 p-5 sm:p-6 hover:shadow-medium transition-all duration-300 flex flex-col justify-between"
          data-animate="animate-fade-in-up"
          data-tilt
          data-animate-delay="400"
        >
          <div>
            <div class="flex items-center mb-4">
              <div
                class="w-12 h-12 bg-amber-50 dark:bg-amber-950/50 rounded-xl flex items-center justify-center mr-3 border border-amber-100 dark:border-amber-800/40"
              >
                <Icon name="tabler:message-circle" class="w-6 h-6 text-accent dark:text-amber-400" />
              </div>
              <h3 class="text-lg font-bold font-heading text-heading dark:text-white">Entrevista</h3>
            </div>
            <p class="text-muted dark:text-slate-300 mb-5 text-sm leading-relaxed">
              Información sobre fechas, agendamiento y preparación para la entrevista familiar.
            </p>
          </div>
          <a
            href="/admisiones/entrevista"
            class="inline-flex items-center gap-2 px-4 py-2.5 bg-primary text-white rounded-xl hover:bg-secondary transition-colors duration-200 text-sm font-semibold w-full justify-center shadow-soft"
          >
            <span>Ver Entrevista</span>
            <Icon name="tabler:arrow-right" class="w-4 h-4" />
          </a>
        </div>
      </div>
    </div>
  </section>
  <WhatsAppButton phoneNumber="573196721410" message="Hola, estoy interesado en sus servicios." />
</Layout>
