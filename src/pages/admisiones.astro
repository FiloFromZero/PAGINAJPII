---
import Layout from '~/layouts/PageLayout.astro';
import HeroText from '~/components/widgets/HeroText.astro';
import { Icon } from 'astro-icon/components';
import WhatsAppButton from '~/components/WhatsAppButton.astro';
import Breadcrumbs from '~/components/ui/Breadcrumbs.astro';

const metadata = {
  title: 'Admisiones',
};

// Configuración de breadcrumbs
const breadcrumbItems = [
  { label: 'Inicio', href: '/' },
  { label: 'Admisiones', current: true }
];
---

<Layout metadata={metadata}>
  <!-- Breadcrumbs Section -->
  <div class="bg-gray-50 dark:bg-gray-800 border-b border-gray-200 dark:border-gray-700">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-4">
      <Breadcrumbs items={breadcrumbItems} />
    </div>
  </div>

  <!-- HeroText Widget ******************* -->

  <HeroText tagline="2026" title="Admisiones" />

  <!-- Secciones de Admisiones -->
  <section class="py-20">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6 lg:gap-8">
        <!-- Prospecto Institucional -->
        <div class="bg-white dark:bg-slate-800 rounded-2xl shadow-xl border border-gray-200 dark:border-slate-700 p-4 sm:p-6 hover:shadow-2xl transition-all duration-300 group">
          <div class="flex items-center mb-3 sm:mb-4">
            <div class="w-10 h-10 sm:w-12 sm:h-12 bg-blue-100 dark:bg-blue-900/30 rounded-xl flex items-center justify-center mr-2 sm:mr-3">
              <Icon name="tabler:file-text" class="w-5 h-5 sm:w-6 sm:h-6 text-blue-600" />
            </div>
            <h3 class="text-base sm:text-lg font-bold text-gray-900 dark:text-white">Prospecto</h3>
          </div>
          <p class="text-gray-600 dark:text-gray-300 mb-3 sm:mb-4 text-xs sm:text-sm">
            Conoce nuestra propuesta educativa y programas académicos para 2026.
          </p>
          <a
            href="/admisiones/prospecto"
            class="inline-flex items-center gap-2 px-3 py-2 sm:px-4 sm:py-2 bg-blue-600 text-white rounded-lg hover:bg-blue-700 transition-colors duration-200 text-xs sm:text-sm font-medium w-full justify-center group-hover:scale-105"
          >
            <Icon name="tabler:arrow-right" class="w-3 h-3 sm:w-4 sm:h-4" />
            Ver Prospecto
          </a>
        </div>

        <!-- Estudiantes Nuevos -->
        <div class="bg-white dark:bg-slate-800 rounded-2xl shadow-xl border border-gray-200 dark:border-slate-700 p-4 sm:p-6 hover:shadow-2xl transition-all duration-300 group">
          <div class="flex items-center mb-3 sm:mb-4">
            <div class="w-10 h-10 sm:w-12 sm:h-12 bg-green-100 dark:bg-green-900/30 rounded-xl flex items-center justify-center mr-2 sm:mr-3">
              <Icon name="tabler:user-plus" class="w-5 h-5 sm:w-6 sm:h-6 text-green-600" />
            </div>
            <h3 class="text-base sm:text-lg font-bold text-gray-900 dark:text-white">Estudiantes Nuevos</h3>
          </div>
          <p class="text-gray-600 dark:text-gray-300 mb-3 sm:mb-4 text-xs sm:text-sm">
            Proceso de admisión y requisitos para nuevos estudiantes.
          </p>
          <a
            href="/admisiones/estudiantes-nuevos"
            class="inline-flex items-center gap-2 px-3 py-2 sm:px-4 sm:py-2 bg-green-600 text-white rounded-lg hover:bg-green-700 transition-colors duration-200 text-xs sm:text-sm font-medium w-full justify-center group-hover:scale-105"
          >
            <Icon name="tabler:arrow-right" class="w-3 h-3 sm:w-4 sm:h-4" />
            Ver Proceso
          </a>
        </div>

        <!-- Estudiantes Antiguos -->
        <div class="bg-white dark:bg-slate-800 rounded-2xl shadow-xl border border-gray-200 dark:border-slate-700 p-4 sm:p-6 hover:shadow-2xl transition-all duration-300 group">
          <div class="flex items-center mb-3 sm:mb-4">
            <div class="w-10 h-10 sm:w-12 sm:h-12 bg-purple-100 dark:bg-purple-900/30 rounded-xl flex items-center justify-center mr-2 sm:mr-3">
              <Icon name="tabler:users" class="w-5 h-5 sm:w-6 sm:h-6 text-purple-600" />
            </div>
            <h3 class="text-base sm:text-lg font-bold text-gray-900 dark:text-white">Estudiantes Antiguos</h3>
          </div>
          <p class="text-gray-600 dark:text-gray-300 mb-3 sm:mb-4 text-xs sm:text-sm">
            Renovación de matrícula y continuidad académica.
          </p>
          <a
            href="/admisiones/estudiantes-antiguos"
            class="inline-flex items-center gap-2 px-3 py-2 sm:px-4 sm:py-2 bg-purple-600 text-white rounded-lg hover:bg-purple-700 transition-colors duration-200 text-xs sm:text-sm font-medium w-full justify-center group-hover:scale-105"
          >
            <Icon name="tabler:arrow-right" class="w-3 h-3 sm:w-4 sm:h-4" />
            Ver Renovación
          </a>
        </div>

        <!-- Entrevista -->
        <div class="bg-white dark:bg-slate-800 rounded-2xl shadow-xl border border-gray-200 dark:border-slate-700 p-4 sm:p-6 hover:shadow-2xl transition-all duration-300 group">
          <div class="flex items-center mb-3 sm:mb-4">
            <div class="w-10 h-10 sm:w-12 sm:h-12 bg-orange-100 dark:bg-orange-900/30 rounded-xl flex items-center justify-center mr-2 sm:mr-3">
              <Icon name="tabler:message-circle" class="w-5 h-5 sm:w-6 sm:h-6 text-orange-600" />
            </div>
            <h3 class="text-base sm:text-lg font-bold text-gray-900 dark:text-white">Entrevista</h3>
          </div>
          <p class="text-gray-600 dark:text-gray-300 mb-3 sm:mb-4 text-xs sm:text-sm">
            Información sobre el proceso de entrevista de admisión.
          </p>
          <a
            href="/admisiones/entrevista"
            class="inline-flex items-center gap-2 px-3 py-2 sm:px-4 sm:py-2 bg-orange-600 text-white rounded-lg hover:bg-orange-700 transition-colors duration-200 text-xs sm:text-sm font-medium w-full justify-center group-hover:scale-105"
          >
            <Icon name="tabler:arrow-right" class="w-3 h-3 sm:w-4 sm:h-4" />
            Ver Entrevista
          </a>
        </div>
      </div>
    </div>
  </section>
  <WhatsAppButton phoneNumber="573196721410" message="Hola, estoy interesado en sus servicios." />
</Layout>
