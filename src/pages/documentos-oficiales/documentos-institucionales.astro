---
import PageLayout from '~/layouts/PageLayout.astro';
import Breadcrumbs from '~/components/ui/Breadcrumbs.astro';
import { Icon } from 'astro-icon/components';
import WhatsAppButton from '~/components/WhatsAppButton.astro';

const breadcrumbs = [
  { label: 'Inicio', href: '/' },
  { label: 'Documentos Institucionales', href: '/documentos-oficiales/documentos-institucionales', current: true }
];
---

<PageLayout metadata={{ title: "Documentos Institucionales - Colegio Juan Pablo II" }}>
  <main class="min-h-screen bg-gradient-to-br from-green-50 via-white to-blue-50 dark:from-slate-900 dark:via-slate-800 dark:to-slate-900">
    <!-- Breadcrumbs -->
    <div class="bg-gray-50 dark:bg-slate-900 border-b border-gray-200 dark:border-slate-700">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-4">
        <Breadcrumbs items={breadcrumbs} />
      </div>
    </div>

    <!-- Hero Section -->
    <section class="relative py-20 overflow-hidden">
      <div class="absolute inset-0 bg-gradient-to-r from-green-600/10 to-blue-600/10"></div>
      <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
        <div class="mb-8">
          <Icon name="tabler:book" class="w-20 h-20 mx-auto text-green-600 mb-6" />
        </div>
        <h1 class="text-5xl md:text-6xl font-bold text-gray-900 dark:text-white mb-6 leading-tight">
          Documentos <span class="text-green-600">Institucionales</span>
        </h1>
        <p class="text-xl text-gray-600 dark:text-gray-300 max-w-3xl mx-auto leading-relaxed">
          Consulta los documentos oficiales de la institución: manual de convivencia, horarios y cronograma de actividades
        </p>
      </div>
    </section>

    <!-- Documentos Institucionales Section -->
    <section id="documentos-institucionales" class="py-20">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="mb-12">
          <h2 class="text-4xl font-bold text-gray-900 dark:text-white mb-4 flex items-center">
            <Icon name="tabler:files" class="w-10 h-10 mr-4 text-green-600" />
            Documentos Institucionales
          </h2>
          <p class="text-lg text-gray-600 dark:text-gray-300 max-w-3xl">
            Documentos oficiales y normativas institucionales
          </p>
        </div>
        
        <div class="grid gap-8 md:grid-cols-2 lg:grid-cols-3">
          <div class="bg-white dark:bg-slate-800 rounded-xl shadow-md p-8 hover:shadow-xl transition-all duration-300 border border-gray-100 dark:border-slate-700 flex flex-col">
            <div class="flex items-start mb-6">
              <div class="flex-shrink-0 w-12 h-12 bg-green-100 dark:bg-green-900/30 rounded-lg flex items-center justify-center mr-4">
                <Icon name="tabler:book-2" class="w-6 h-6 text-green-600" />
              </div>
              <div class="flex-1">
                <h3 class="text-xl font-semibold text-gray-900 dark:text-white mb-2 leading-tight">Manual de Convivencia 2025</h3>
              </div>
            </div>
            <p class="text-gray-600 dark:text-gray-300 mb-6 leading-relaxed flex-grow">Manual de convivencia escolar actualizado para el año académico 2025</p>
            <div class="text-center mt-auto">
              <a href="/files/MANUAL2025.pdf" target="_blank" 
                 class="inline-flex items-center px-6 py-3 bg-green-600 text-white rounded-lg hover:bg-green-700 transition-colors duration-200 font-medium">
                <Icon name="tabler:download" class="w-5 h-5 mr-2" />
                Descargar PDF
              </a>
            </div>
          </div>
          
          <div class="bg-white dark:bg-slate-800 rounded-xl shadow-md p-8 hover:shadow-xl transition-all duration-300 border border-gray-100 dark:border-slate-700 flex flex-col">
            <div class="flex items-start mb-6">
              <div class="flex-shrink-0 w-12 h-12 bg-blue-100 dark:bg-blue-900/30 rounded-lg flex items-center justify-center mr-4">
                <Icon name="tabler:clock" class="w-6 h-6 text-blue-600" />
              </div>
              <div class="flex-1">
                <h3 class="text-xl font-semibold text-gray-900 dark:text-white mb-2 leading-tight">Horario Escolar</h3>
              </div>
            </div>
            <p class="text-gray-600 dark:text-gray-300 mb-6 leading-relaxed flex-grow">Horario académico actualizado para el año 2025</p>
            <div class="text-center mt-auto">
              <a href="/files/horario2025.pdf" target="_blank" 
                 class="inline-flex items-center px-6 py-3 bg-blue-600 text-white rounded-lg hover:bg-blue-700 transition-colors duration-200 font-medium">
                <Icon name="tabler:download" class="w-5 h-5 mr-2" />
                Descargar PDF
              </a>
            </div>
          </div>
          
          <div class="bg-white dark:bg-slate-800 rounded-xl shadow-md p-8 hover:shadow-xl transition-all duration-300 border border-gray-100 dark:border-slate-700 flex flex-col">
            <div class="flex items-start mb-6">
              <div class="flex-shrink-0 w-12 h-12 bg-purple-100 dark:bg-purple-900/30 rounded-lg flex items-center justify-center mr-4">
                <Icon name="tabler:calendar-event" class="w-6 h-6 text-purple-600" />
              </div>
              <div class="flex-1">
                <h3 class="text-xl font-semibold text-gray-900 dark:text-white mb-2 leading-tight">Cronograma de Actividades 2025</h3>
              </div>
            </div>
            <p class="text-gray-600 dark:text-gray-300 mb-6 leading-relaxed flex-grow">Cronograma oficial de actividades académicas y eventos institucionales para el año 2025</p>
            <div class="text-center mt-auto">
              <a href="/files/cronograma2025.pdf" target="_blank" 
                 class="inline-flex items-center px-6 py-3 bg-purple-600 text-white rounded-lg hover:bg-purple-700 transition-colors duration-200 font-medium">
                <Icon name="tabler:download" class="w-5 h-5 mr-2" />
                Descargar PDF
              </a>
            </div>
          </div>
          
          <div class="bg-white dark:bg-slate-800 rounded-xl shadow-md p-8 hover:shadow-xl transition-all duration-300 border border-gray-100 dark:border-slate-700 flex flex-col">
            <div class="flex items-start mb-6">
              <div class="flex-shrink-0 w-12 h-12 bg-red-100 dark:bg-red-900/30 rounded-lg flex items-center justify-center mr-4">
                <Icon name="tabler:scale" class="w-6 h-6 text-red-600" />
              </div>
              <div class="flex-1">
                <h3 class="text-xl font-semibold text-gray-900 dark:text-white mb-2 leading-tight">Reglamento Interno de Trabajo</h3>
              </div>
            </div>
            <p class="text-gray-600 dark:text-gray-300 mb-6 leading-relaxed flex-grow">Normativa laboral y disposiciones internas vigentes del colegio.</p>
            <div class="text-center mt-auto">
              <a href="/files/REGLAMENTO_INTERNO_JUAN_PABLO_II.pdf" target="_blank" rel="noopener noreferrer"
                 class="inline-flex items-center px-6 py-3 bg-red-600 text-white rounded-lg hover:bg-red-700 transition-colors duration-200 font-medium">
                <Icon name="tabler:download" class="w-5 h-5 mr-2" />
                Descargar PDF
              </a>
            </div>
          </div>
        </div>
      </div>
    </section>
  </main>

  <WhatsAppButton phoneNumber="573196721410" message="Hola, estoy interesado en sus servicios." />
</PageLayout>