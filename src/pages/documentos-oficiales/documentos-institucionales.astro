---
import PageLayout from '~/layouts/PageLayout.astro';
import Breadcrumbs from '~/components/ui/Breadcrumbs.astro';
import { Icon } from 'astro-icon/components';
import WhatsAppButton from '~/components/WhatsAppButton.astro';

const breadcrumbs = [
  { label: 'Inicio', href: '/' },
  { label: 'Documentos Institucionales', href: '/documentos-oficiales/documentos-institucionales', current: true }
];
---

<PageLayout metadata={{ title: "Documentos Institucionales - Colegio Juan Pablo II" }}>
  <main class="min-h-screen bg-gradient-to-br from-emerald-50/40 via-white to-slate-50 dark:from-slate-900 dark:via-slate-800 dark:to-slate-900">
    <!-- Breadcrumbs -->
    <div class="bg-gray-50 dark:bg-slate-900 border-b border-gray-200 dark:border-slate-700">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-4">
        <Breadcrumbs items={breadcrumbs} />
      </div>
    </div>

    <!-- Hero Section -->
    <section class="relative py-16 sm:py-20 overflow-hidden">
      <div class="absolute inset-0 bg-gradient-to-r from-primary/5 to-secondary/5"></div>
      <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center" data-animate="animate-fade-in-up">
        <div class="mb-6">
          <div class="w-20 h-20 mx-auto rounded-2xl bg-emerald-100 dark:bg-emerald-950/40 border border-emerald-200 dark:border-emerald-800/40 flex items-center justify-center mb-6">
            <Icon name="tabler:book" class="w-10 h-10 text-primary dark:text-emerald-400" />
          </div>
        </div>
        <h1 class="text-4xl sm:text-5xl md:text-6xl font-bold font-heading text-gray-900 dark:text-white mb-6 leading-tight">
          Documentos <span class="text-primary dark:text-emerald-400">Institucionales</span>
        </h1>
        <p class="text-lg sm:text-xl text-gray-600 dark:text-gray-300 max-w-3xl mx-auto leading-relaxed">
          Consulta los documentos oficiales de la institución: manual de convivencia, horarios y cronograma de actividades
        </p>
      </div>
    </section>

    <!-- Documentos Institucionales Section -->
    <section id="documentos-institucionales" class="py-12 sm:py-16 lg:py-20">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="mb-12 text-center sm:text-left" data-animate="animate-fade-in-up">
          <h2 class="text-3xl sm:text-4xl font-bold font-heading text-gray-900 dark:text-white mb-4 flex items-center justify-center sm:justify-start gap-3">
            <Icon name="tabler:files" class="w-8 h-8 sm:w-10 sm:h-10 text-primary dark:text-emerald-400" />
            Documentos Institucionales
          </h2>
          <p class="text-base sm:text-lg text-gray-600 dark:text-gray-300 max-w-3xl">
            Documentos oficiales y normativas institucionales
          </p>
        </div>
        
        <div class="grid gap-6 sm:gap-8 md:grid-cols-2 lg:grid-cols-3">
          <!-- Manual de Convivencia -->
          <div class="bg-white dark:bg-slate-800 rounded-2xl shadow-soft hover:shadow-medium p-6 sm:p-8 transition-all duration-300 border border-gray-100 dark:border-slate-700 flex flex-col" data-animate="animate-fade-in-up" data-animate-delay="100">
            <div class="flex items-start mb-6">
              <div class="flex-shrink-0 w-14 h-14 bg-emerald-100 dark:bg-emerald-950/40 border border-emerald-200 dark:border-emerald-800/40 rounded-xl flex items-center justify-center mr-4">
                <Icon name="tabler:book-2" class="w-7 h-7 text-primary dark:text-emerald-400" />
              </div>
              <div class="flex-1">
                <h3 class="text-xl font-bold font-heading text-gray-900 dark:text-white mb-2 leading-tight">Manual de Convivencia 2025</h3>
              </div>
            </div>
            <p class="text-gray-600 dark:text-gray-300 text-sm sm:text-base mb-6 leading-relaxed flex-grow">Manual de convivencia escolar actualizado para el año académico 2025</p>
            <div class="text-center mt-auto">
              <a href="/files/MANUAL2025.pdf" target="_blank" 
                 class="inline-flex items-center justify-center w-full gap-2 px-6 py-3.5 bg-primary text-white rounded-xl hover:bg-secondary transition-colors duration-200 font-semibold text-base shadow-soft">
                <Icon name="tabler:download" class="w-5 h-5" />
                Descargar PDF
              </a>
            </div>
          </div>
          
          <!-- Horario Escolar -->
          <div class="bg-white dark:bg-slate-800 rounded-2xl shadow-soft hover:shadow-medium p-6 sm:p-8 transition-all duration-300 border border-gray-100 dark:border-slate-700 flex flex-col" data-animate="animate-fade-in-up" data-animate-delay="200">
            <div class="flex items-start mb-6">
              <div class="flex-shrink-0 w-14 h-14 bg-amber-50 dark:bg-amber-950/40 border border-amber-200 dark:border-amber-800/40 rounded-xl flex items-center justify-center mr-4">
                <Icon name="tabler:clock" class="w-7 h-7 text-amber-600 dark:text-amber-400" />
              </div>
              <div class="flex-1">
                <h3 class="text-xl font-bold font-heading text-gray-900 dark:text-white mb-2 leading-tight">Horario Escolar</h3>
              </div>
            </div>
            <p class="text-gray-600 dark:text-gray-300 text-sm sm:text-base mb-6 leading-relaxed flex-grow">Horario académico actualizado para el año 2025</p>
            <div class="text-center mt-auto">
              <a href="/files/horario2025.pdf" target="_blank" 
                 class="inline-flex items-center justify-center w-full gap-2 px-6 py-3.5 bg-primary text-white rounded-xl hover:bg-secondary transition-colors duration-200 font-semibold text-base shadow-soft">
                <Icon name="tabler:download" class="w-5 h-5" />
                Descargar PDF
              </a>
            </div>
          </div>
          
          <!-- Cronograma -->
          <div class="bg-white dark:bg-slate-800 rounded-2xl shadow-soft hover:shadow-medium p-6 sm:p-8 transition-all duration-300 border border-gray-100 dark:border-slate-700 flex flex-col" data-animate="animate-fade-in-up" data-animate-delay="300">
            <div class="flex items-start mb-6">
              <div class="flex-shrink-0 w-14 h-14 bg-emerald-100 dark:bg-emerald-950/40 border border-emerald-200 dark:border-emerald-800/40 rounded-xl flex items-center justify-center mr-4">
                <Icon name="tabler:calendar-event" class="w-7 h-7 text-primary dark:text-emerald-400" />
              </div>
              <div class="flex-1">
                <h3 class="text-xl font-bold font-heading text-gray-900 dark:text-white mb-2 leading-tight">Cronograma de Actividades 2025</h3>
              </div>
            </div>
            <p class="text-gray-600 dark:text-gray-300 text-sm sm:text-base mb-6 leading-relaxed flex-grow">Cronograma oficial de actividades académicas y eventos institucionales para el año 2025</p>
            <div class="text-center mt-auto">
              <a href="/files/cronograma2025.pdf" target="_blank" 
                 class="inline-flex items-center justify-center w-full gap-2 px-6 py-3.5 bg-primary text-white rounded-xl hover:bg-secondary transition-colors duration-200 font-semibold text-base shadow-soft">
                <Icon name="tabler:download" class="w-5 h-5" />
                Descargar PDF
              </a>
            </div>
          </div>
          
          <!-- Reglamento Interno -->
          <div class="bg-white dark:bg-slate-800 rounded-2xl shadow-soft hover:shadow-medium p-6 sm:p-8 transition-all duration-300 border border-gray-100 dark:border-slate-700 flex flex-col" data-animate="animate-fade-in-up" data-animate-delay="400">
            <div class="flex items-start mb-6">
              <div class="flex-shrink-0 w-14 h-14 bg-amber-50 dark:bg-amber-950/40 border border-amber-200 dark:border-amber-800/40 rounded-xl flex items-center justify-center mr-4">
                <Icon name="tabler:scale" class="w-7 h-7 text-amber-600 dark:text-amber-400" />
              </div>
              <div class="flex-1">
                <h3 class="text-xl font-bold font-heading text-gray-900 dark:text-white mb-2 leading-tight">Reglamento Interno de Trabajo</h3>
              </div>
            </div>
            <p class="text-gray-600 dark:text-gray-300 text-sm sm:text-base mb-6 leading-relaxed flex-grow">Normativa laboral y disposiciones internas vigentes del colegio.</p>
            <div class="text-center mt-auto" oncontextmenu="return false" ondragstart="return false">
              <a href="/documentos-oficiales/reglamento"
                 class="inline-flex items-center justify-center w-full gap-2 px-6 py-3.5 bg-gradient-to-r from-primary to-secondary text-white rounded-xl hover:opacity-95 transition-all duration-200 font-semibold text-base shadow-soft">
                <Icon name="tabler:eye" class="w-5 h-5" />
                Ver en línea
              </a>
            </div>
          </div>
        </div>
      </div>
    </section>
  </main>

  <WhatsAppButton phoneNumber="573196721410" message="Hola, estoy interesado en sus servicios." />
</PageLayout>