---
import Layout from '~/layouts/PageLayout.astro';
import HeroText from '~/components/widgets/HeroText.astro';
import { Icon } from 'astro-icon/components';
import WhatsAppButton from '~/components/WhatsAppButton.astro';
import Breadcrumbs from '~/components/ui/Breadcrumbs.astro';

const metadata = {
  title: 'Documentos Oficiales',
};

// Configuración de breadcrumbs
const breadcrumbItems = [
  { label: 'Inicio', href: '/' },
  { label: 'Documentos Oficiales', current: true }
];
---

<Layout metadata={metadata}>
  <!-- Breadcrumbs Section -->
  <div class="bg-gray-50 dark:bg-gray-800 border-b border-gray-200 dark:border-gray-700">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-4">
      <Breadcrumbs items={breadcrumbItems} />
    </div>
  </div>

  <!-- HeroText Widget ******************* -->
  <HeroText tagline="Información Oficial" title="Documentos Oficiales" />

  <!-- Secciones de Documentos -->
  <section class="py-20">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-8 lg:gap-12">
        
        <!-- Documentos de Secretaría -->
        <div class="bg-white dark:bg-slate-800 rounded-2xl shadow-xl border border-gray-200 dark:border-slate-700 p-8 hover:shadow-2xl transition-all duration-300 group flex flex-col">
          <div class="flex items-center mb-6">
            <div class="w-16 h-16 bg-blue-100 dark:bg-blue-900/30 rounded-xl flex items-center justify-center mr-4">
              <Icon name="tabler:file-certificate" class="w-8 h-8 text-blue-600" />
            </div>
            <h3 class="text-2xl font-bold text-gray-900 dark:text-white">Documentos de Secretaría</h3>
          </div>
          <p class="text-gray-600 dark:text-gray-300 mb-6 text-lg leading-relaxed flex-grow">
            Accede a formularios, cronogramas, manuales y documentos administrativos necesarios para trámites académicos y procesos institucionales.
          </p>
          <div class="space-y-3 mb-8">
            <div class="flex items-center text-gray-600 dark:text-gray-300">
              <Icon name="tabler:check" class="w-5 h-5 text-green-500 mr-2" />
              <span>Formularios de admisión y traslados</span>
            </div>
            <div class="flex items-center text-gray-600 dark:text-gray-300">
              <Icon name="tabler:check" class="w-5 h-5 text-green-500 mr-2" />
              <span>Cronogramas académicos</span>
            </div>
            <div class="flex items-center text-gray-600 dark:text-gray-300">
              <Icon name="tabler:check" class="w-5 h-5 text-green-500 mr-2" />
              <span>Manuales y reglamentos</span>
            </div>
          </div>
          <div class="mt-auto">
            <a
              href="/documentos-oficiales/documentos-secretaria"
              class="inline-flex items-center gap-3 px-6 py-3 bg-blue-600 text-white rounded-lg hover:bg-blue-700 transition-colors duration-200 text-lg font-medium w-full justify-center group-hover:scale-105"
            >
              <Icon name="tabler:arrow-right" class="w-5 h-5" />
              Acceder a Documentos
            </a>
          </div>
        </div>

        <!-- Documentos Institucionales -->
        <div class="bg-white dark:bg-slate-800 rounded-2xl shadow-xl border border-gray-200 dark:border-slate-700 p-8 hover:shadow-2xl transition-all duration-300 group flex flex-col">
          <div class="flex items-center mb-6">
            <div class="w-16 h-16 bg-green-100 dark:bg-green-900/30 rounded-xl flex items-center justify-center mr-4">
              <Icon name="tabler:building-bank" class="w-8 h-8 text-green-600" />
            </div>
            <h3 class="text-2xl font-bold text-gray-900 dark:text-white">Documentos Institucionales</h3>
          </div>
          <p class="text-gray-600 dark:text-gray-300 mb-6 text-lg leading-relaxed flex-grow">
            Consulta resoluciones, prospectos institucionales, documentos legales y normativas que rigen el funcionamiento del colegio.
          </p>
          <div class="space-y-3 mb-8">
            <div class="flex items-center text-gray-600 dark:text-gray-300">
              <Icon name="tabler:check" class="w-5 h-5 text-green-500 mr-2" />
              <span>Resoluciones oficiales</span>
            </div>
            <div class="flex items-center text-gray-600 dark:text-gray-300">
              <Icon name="tabler:check" class="w-5 h-5 text-green-500 mr-2" />
              <span>Prospecto institucional</span>
            </div>
            <div class="flex items-center text-gray-600 dark:text-gray-300">
              <Icon name="tabler:check" class="w-5 h-5 text-green-500 mr-2" />
              <span>Documentos legales</span>
            </div>
          </div>
          <div class="mt-auto">
            <a
              href="/documentos-oficiales/documentos-institucionales"
              class="inline-flex items-center gap-3 px-6 py-3 bg-green-600 text-white rounded-lg hover:bg-green-700 transition-colors duration-200 text-lg font-medium w-full justify-center group-hover:scale-105"
            >
              <Icon name="tabler:arrow-right" class="w-5 h-5" />
              Acceder a Documentos
            </a>
          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- Información adicional -->
  <section class="py-16 bg-gray-50 dark:bg-gray-900">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <div class="bg-blue-50 dark:bg-blue-900/20 rounded-2xl p-8">
        <Icon name="tabler:info-circle" class="w-12 h-12 text-blue-600 mx-auto mb-4" />
        <h3 class="text-2xl font-bold text-gray-900 dark:text-white mb-4">Información Importante</h3>
        <p class="text-gray-600 dark:text-gray-300 text-lg leading-relaxed">
          Todos los documentos están disponibles en formato PDF. Si necesitas ayuda para acceder a algún documento específico o tienes preguntas sobre los trámites, no dudes en contactarnos.
        </p>
      </div>
    </div>
  </section>

  <!-- WhatsApp Button -->
  <WhatsAppButton phoneNumber="573196721410" message="Hola, necesito información sobre documentos oficiales." />
</Layout>