---
import Layout from '~/layouts/PageLayout.astro';
import HeroText from '~/components/widgets/HeroText.astro';
import WhatsAppButton from '~/components/WhatsAppButton.astro';
import Breadcrumbs from '~/components/ui/Breadcrumbs.astro';
import { Icon } from 'astro-icon/components';

const metadata = {
  title: 'Buzones de Notificaciones Judiciales',
};

// Configuración de breadcrumbs
const breadcrumbItems = [
  { label: 'Inicio', href: '/' },
  { label: 'Notificaciones Judiciales', current: true },
];
---

<Layout metadata={metadata}>
  <!-- Breadcrumbs Section -->
  <div class="bg-gray-50 dark:bg-slate-900 border-b border-gray-200 dark:border-slate-700">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-4">
      <Breadcrumbs items={breadcrumbItems} />
    </div>
  </div>

  <!-- HeroText Widget -->
  <HeroText tagline="Información Legal" title="Buzones de Notificaciones Judiciales" />

  <!-- Sección principal -->
  <section class="px-4 py-12 sm:px-6 sm:py-16 lg:px-8 lg:py-20">
    <div class="max-w-4xl mx-auto">

      <!-- Descripción introductoria -->
      <div class="bg-white dark:bg-slate-800 rounded-2xl shadow-soft hover:shadow-medium border border-gray-200 dark:border-slate-700 p-5 sm:p-8 mb-6 sm:mb-10" data-animate="animate-fade-in-up">
        <div class="flex flex-col xs:flex-row sm:flex-row items-start gap-4 sm:gap-5">
          <div class="w-12 h-12 sm:w-16 sm:h-16 min-w-[3rem] sm:min-w-[4rem] bg-emerald-100 dark:bg-emerald-950/40 rounded-xl flex items-center justify-center shrink-0 border border-emerald-200 dark:border-emerald-800/40">
            <Icon name="tabler:mail-opened" class="w-6 h-6 sm:w-8 sm:h-8 text-primary dark:text-emerald-400" />
          </div>
          <div>
            <h2 class="text-xl sm:text-2xl font-bold font-heading text-gray-900 dark:text-white mb-2 sm:mb-3">
              ¿Qué son los buzones de notificaciones judiciales?
            </h2>
            <p class="text-gray-600 dark:text-gray-300 text-sm sm:text-base md:text-lg leading-relaxed">
              El Instituto Psicopedagógico Juan Pablo II cuenta con buzones de correo electrónico habilitados
              <strong>única y exclusivamente</strong> para el recibo de notificaciones judiciales por parte de los
              Órganos Judiciales. Los mensajes que <strong>no correspondan a asuntos de orden judicial no serán tramitados</strong>.
            </p>
          </div>
        </div>
      </div>

      <!-- Buzones de correo -->
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 sm:gap-6 mb-6 sm:mb-10">

        <!-- Buzón 1: Notificaciones Judiciales -->
        <div class="bg-white dark:bg-slate-800 rounded-2xl shadow-soft hover:shadow-medium border border-gray-200 dark:border-slate-700 p-5 sm:p-7 transition-all duration-300 flex flex-col" data-animate="animate-fade-in-up" data-tilt data-animate-delay="100">
          <div class="w-11 h-11 sm:w-14 sm:h-14 bg-emerald-100 dark:bg-emerald-950/40 rounded-xl flex items-center justify-center mb-4 border border-emerald-200 dark:border-emerald-800/40">
            <Icon name="tabler:gavel" class="w-5 h-5 sm:w-7 sm:h-7 text-primary dark:text-emerald-400" />
          </div>
          <h3 class="text-base sm:text-xl font-bold font-heading text-gray-900 dark:text-white mb-2">
            Notificaciones Judiciales
          </h3>
          <p class="text-gray-600 dark:text-gray-300 text-sm leading-relaxed mb-4 sm:mb-5 flex-grow">
            Buzón destinado exclusivamente para la recepción de notificaciones y comunicaciones de carácter judicial por parte de los Órganos Judiciales competentes.
          </p>
          <div
            class="flex items-start gap-2 w-full px-3 sm:px-4 py-3 bg-emerald-50/70 dark:bg-emerald-950/30 border border-emerald-200 dark:border-emerald-800 text-emerald-900 dark:text-emerald-200 text-xs sm:text-sm font-semibold rounded-xl select-all cursor-text"
            title="Copia este correo"
          >
            <Icon name="tabler:mail" class="w-4 h-4 sm:w-5 sm:h-5 flex-shrink-0 text-primary dark:text-emerald-400 mt-0.5" />
            <span class="break-all leading-snug">notificacionesjudiciales@iejuanpabloiisoacha.edu.co</span>
          </div>
        </div>

        <!-- Buzón 2: PQRS -->
        <div class="bg-white dark:bg-slate-800 rounded-2xl shadow-soft hover:shadow-medium border border-gray-200 dark:border-slate-700 p-5 sm:p-7 transition-all duration-300 flex flex-col" data-animate="animate-fade-in-up" data-tilt data-animate-delay="200">
          <div class="w-11 h-11 sm:w-14 sm:h-14 bg-amber-50 dark:bg-amber-950/30 rounded-xl flex items-center justify-center mb-4 border border-amber-200 dark:border-amber-800/40">
            <Icon name="tabler:message-report" class="w-5 h-5 sm:w-7 sm:h-7 text-amber-600 dark:text-amber-400" />
          </div>
          <h3 class="text-base sm:text-xl font-bold font-heading text-gray-900 dark:text-white mb-2">
            PQRS – Peticiones, Quejas y Sugerencias
          </h3>
          <p class="text-gray-600 dark:text-gray-300 text-sm leading-relaxed mb-4 sm:mb-5 flex-grow">
            Canal oficial para el envío de peticiones, quejas, reclamos, felicitaciones, sugerencias y opiniones relacionadas con la prestación del servicio educativo.
          </p>
          <div
            class="flex items-center gap-2 w-full px-3 sm:px-4 py-3 bg-amber-50/70 dark:bg-amber-950/30 border border-amber-200 dark:border-amber-800 text-amber-900 dark:text-amber-200 text-xs sm:text-sm font-semibold rounded-xl select-all cursor-text"
            title="Copia este correo"
          >
            <Icon name="tabler:mail" class="w-4 h-4 sm:w-5 sm:h-5 flex-shrink-0 text-amber-600 dark:text-amber-400" />
            <span class="break-all">pqrs@iejuanpabloiisoacha.edu.co</span>
          </div>
        </div>

      </div>

      <!-- Nota importante -->
      <div class="bg-red-50/80 dark:bg-red-950/30 border border-red-200 dark:border-red-800/60 rounded-2xl p-5 sm:p-6 mb-6 sm:mb-10" data-animate="animate-fade-in-up">
        <div class="flex flex-col sm:flex-row items-start gap-3 sm:gap-4">
          <div class="w-10 h-10 sm:w-12 sm:h-12 min-w-[2.5rem] sm:min-w-[3rem] bg-red-100 dark:bg-red-900/40 rounded-xl flex items-center justify-center shrink-0 border border-red-200 dark:border-red-800">
            <Icon name="tabler:alert-triangle" class="w-5 h-5 sm:w-6 sm:h-6 text-red-600 dark:text-red-400" />
          </div>
          <div>
            <h3 class="text-base sm:text-lg font-bold text-red-800 dark:text-red-300 mb-1 sm:mb-2">
              Importante
            </h3>
            <p class="text-red-700 dark:text-red-200 text-sm sm:text-base leading-relaxed">
              Estos buzones son de uso <strong>exclusivo para notificaciones judiciales</strong> provenientes de Órganos Judiciales.
              Los correos que no correspondan a asuntos de orden judicial <strong>no serán tramitados</strong>.
              Para otras solicitudes utilice el formulario de contacto o el buzón PQRS.
            </p>
          </div>
        </div>
      </div>

      <!-- Enlace a contacto -->
      <div class="bg-slate-50 dark:bg-slate-800/80 border border-slate-200 dark:border-slate-700 rounded-2xl p-6 sm:p-8 text-center" data-animate="animate-fade-in-up">
        <div class="w-12 h-12 rounded-full bg-primary/10 dark:bg-emerald-950/50 flex items-center justify-center mx-auto mb-3 sm:mb-4 border border-primary/20">
          <Icon name="tabler:info-circle" class="w-6 h-6 text-primary dark:text-emerald-400" />
        </div>
        <h3 class="text-lg sm:text-2xl font-bold font-heading text-gray-900 dark:text-white mb-2 sm:mb-4">
          ¿Necesitas comunicarte por otro motivo?
        </h3>
        <p class="text-gray-600 dark:text-gray-300 text-sm sm:text-base max-w-xl mx-auto leading-relaxed mb-5 sm:mb-6">
          Para solicitudes generales, información académica o comentarios, visita nuestra página de contacto.
        </p>
        <a
          href="/contacto"
          class="inline-flex items-center gap-2 sm:gap-3 px-6 sm:px-8 py-3 sm:py-3.5 bg-gradient-to-r from-primary to-secondary text-white font-semibold rounded-xl shadow-soft hover:shadow-medium hover:-translate-y-0.5 transition-all duration-300 text-base"
        >
          <Icon name="tabler:arrow-right" class="w-4 h-4 sm:w-5 sm:h-5" />
          Ir a Contacto
        </a>
      </div>

    </div>
  </section>

  <!-- WhatsApp Button -->
  <WhatsAppButton phoneNumber="573196721410" message="Hola, tengo una consulta sobre notificaciones judiciales." />
</Layout>
